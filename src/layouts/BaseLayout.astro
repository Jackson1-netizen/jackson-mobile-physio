---
import "../styles/global.css";
import "../styles/home-motion.css";
import "../styles/mobile-approved.css";
import { site } from "../content/site";
import { getLocalBusinessJsonLd, getFaqJsonLd } from "../lib/structured-data";
import DraftBanner from "../components/DraftBanner.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import FloatingContact from "../components/FloatingContact.astro";
import I18nScript from "../components/I18nScript.astro";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string | false;
  hideChrome?: boolean;
  /** Homepage V1: draft banner only; full chrome inside page component */
  v1Home?: boolean;
  includeFaqSchema?: boolean;
  /** When true, a stored language preference may set html lang and translate the page. */
  translatable?: boolean;
  /** Limit the embedded translation bundle to these top-level keys. */
  i18nInclude?: readonly string[];
  /** Always noindex, including after launch. Used by the 404 page. */
  noindex?: boolean;
}

const {
  title = site.seo.defaultTitle,
  description = site.seo.description,
  canonicalPath = "/",
  hideChrome = false,
  v1Home = false,
  includeFaqSchema = false,
  translatable = false,
  i18nInclude,
  noindex = false,
} = Astro.props;

const showSiteChrome = !hideChrome && !v1Home;
const showDraftBanner = site.draft && (showSiteChrome || v1Home);
// The Contact and receipt pages already give visitors their next step.
const pagePath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const showFloatingContact = (showSiteChrome || v1Home) && !["/enquiry", "/enquiry-received", "/referral", "/referral-received"].includes(pagePath);
function toCanonical(path: string): string {
  const slashed = path === "/" ? "/" : path.endsWith("/") ? path : `${path}/`;
  return new URL(slashed, site.websiteUrl).href;
}

const canonicalUrl = canonicalPath === false ? "" : toCanonical(canonicalPath);
const emitCanonical = canonicalUrl !== "";
const ogImage = new URL(site.seo.ogImagePath, site.websiteUrl).href;
const jsonLd = JSON.stringify(getLocalBusinessJsonLd());
const faqLd = includeFaqSchema ? JSON.stringify(getFaqJsonLd()) : null;
const robotsContent = site.draft || noindex ? "noindex, nofollow" : "index, follow";
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    {emitCanonical && <link rel="canonical" href={canonicalUrl} />}
    <meta name="theme-color" content="#173d35" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.seo.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {emitCanonical && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(site.seo.ogImageWidth)} />
    <meta property="og:image:height" content={String(site.seo.ogImageHeight)} />
    <meta property="og:image:alt" content={site.seo.ogImageAlt} />
    <meta property="og:site_name" content={site.businessName} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={site.seo.ogImageAlt} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/icon-96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <script type="application/ld+json" set:html={jsonLd} />
    {faqLd && <script type="application/ld+json" set:html={faqLd} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content" data-i18n-path="hm.skipLink">Skip to main content</a>
    {showDraftBanner && <DraftBanner />}
    {showSiteChrome && <SiteHeader />}
    {
      v1Home ? (
        <slot />
      ) : (
        <main id="main-content" tabindex="-1">
          <slot />
        </main>
      )
    }
    {showSiteChrome && <SiteFooter referralForm={pagePath === "/referral"} />}
    {showFloatingContact && <FloatingContact />}
    {translatable && <I18nScript include={i18nInclude} />}
  </body>
</html>
