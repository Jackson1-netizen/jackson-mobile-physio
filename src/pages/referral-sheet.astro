---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHeader from "../components/home/HomeHeader.astro";
import HomeIcon from "../components/home/HomeIcon.astro";
import ReferralPrintButton from "../components/ReferralPrintButton.astro";
import { site, getReferralEmailHref } from "../content/site";
import { messages } from "../content/i18n";
import "../styles/referral.css";

const copy = messages.en.referralPage;
const t = copy.designA;
const glanceIcons = ["pin", "people", "home", "clipboard"] as const;
const referralMailto = getReferralEmailHref();
const publicDomain = new URL(site.referralSheetUrl).hostname;
---

<BaseLayout
  v1Home={true}
  translatable={true}
  i18nInclude={["nav", "cta", "sections", "hm", "referralPage"]}
  title={"For referrers | " + site.businessName}
  description={copy.intro}
  canonicalPath="/referral-sheet"
>
  <div class="hm ref-a">
    <HomeHeader />
    <main id="main-content" tabindex="-1">
      <section class="ref-a-hero" aria-labelledby="ref-heading">
        <div class="ref-a-hero-inner">
          <span class="ref-a-rule" aria-hidden="true"></span>
          <h1 id="ref-heading" data-i18n-path="referralPage.heading">{copy.heading}</h1>
          <p class="ref-a-subtitle" data-i18n-path="referralPage.designA.subtitle">{t.subtitle}</p>
          <p class="ref-a-intro" data-i18n-path="referralPage.designA.intro">{t.intro}</p>
          <div class="ref-a-actions no-print">
            <a class="ref-a-enquire" href="/enquiry/">
              <span data-i18n-path="referralPage.designA.enquire">{t.enquire}</span>
              <span aria-hidden="true">→</span>
            </a>
            <a class="ref-a-call" href={site.phoneHref}>
              <HomeIcon name="phone" size={25} />
              <span data-i18n-path="referralPage.designA.call">{t.call}</span>
            </a>
          </div>
          <div class="ref-a-hero-print no-print">
            <ReferralPrintButton />
            <noscript><p data-i18n-path="referralPage.printNote">{copy.printNote}</p></noscript>
          </div>
        </div>
      </section>

      <div class="ref-a-body">
        <section class="ref-a-glance" aria-labelledby="ref-glance-heading">
          <h2 id="ref-glance-heading" data-i18n-path="referralPage.designA.glance">{t.glance}</h2>
          <ul class="ref-a-glance-list">
            {t.glanceItems.map((item, i) => (
              <li>
                <HomeIcon name={glanceIcons[i]} size={39} />
                <span data-i18n-path={"referralPage.designA.glanceItems." + i}>{item}</span>
              </li>
            ))}
          </ul>
        </section>

        <section id="referral-details" class="ref-a-process" aria-labelledby="ref-process-heading">
          <h2 id="ref-process-heading" data-i18n-path="referralPage.howHeading">{copy.howHeading}</h2>
          <ol class="ref-a-steps">
            {t.steps.map((step, i) => (
              <li>
                <div class="ref-a-step-track" aria-hidden="true"><span>{i + 1}</span></div>
                <h3 data-i18n-path={"referralPage.designA.steps." + i + ".title"}>{step.title}</h3>
                <p data-i18n-path={"referralPage.designA.steps." + i + ".body"}>{step.body}</p>
              </li>
            ))}
          </ol>
        </section>

        <div class="ref-a-panels">
          <div class="ref-a-support">
            <section aria-labelledby="ref-support-heading">
              <h2 id="ref-support-heading" data-i18n-path="referralPage.designA.supportHeading">{t.supportHeading}</h2>
              <p data-i18n-path="referralPage.designA.supportBody">{t.supportBody}</p>
            </section>
            <section class="ref-a-funding" aria-labelledby="ref-funding-heading">
              <h2 id="ref-funding-heading" data-i18n-path="referralPage.designA.fundingHeading">{t.fundingHeading}</h2>
              <p data-i18n-path="referralPage.ndisDescription">{copy.ndisDescription}</p>
              <p class="ref-a-funding-note">
                <span data-i18n-path="referralPage.ndisNotRegistered">{copy.ndisNotRegistered}</span>{" "}
                <span data-i18n-path="referralPage.designA.fundingNote">{t.fundingNote}</span>
              </p>
            </section>
          </div>

          <section class="ref-a-checklist" aria-labelledby="ref-checklist-heading">
            <h2 id="ref-checklist-heading" data-i18n-path="referralPage.designA.checklistHeading">{t.checklistHeading}</h2>
            <ul>
              {t.checklist.map((item, i) => (
                <li>
                  <span class="ref-a-check" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="m5 12 4 4L19 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </span>
                  <span data-i18n-path={"referralPage.designA.checklist." + i}>{item}</span>
                </li>
              ))}
            </ul>
            <p class="ref-a-warning">
              <span class="ref-a-warning-icon" aria-hidden="true">!</span>
              <span data-i18n-path="referralPage.designA.warning">{t.warning}</span>
            </p>
          </section>
        </div>

        <section id="referral-contact" class="ref-a-contact" aria-labelledby="ref-contact-heading">
          <h2 id="ref-contact-heading" data-i18n-path="referralPage.designA.contactHeading">{t.contactHeading}</h2>
          <div class="ref-a-contact-links">
            <a class="ref-a-phone" href={site.phoneHref}>
              <span class="ref-a-contact-icon"><HomeIcon name="phone" size={27} /></span>
              <span>{site.phone}</span>
            </a>
            <a class="ref-a-email" href={referralMailto}>
              <span class="ref-a-contact-icon"><HomeIcon name="mail" size={28} /></span>
              <span>{site.referralEmail}</span>
            </a>
          </div>
          <div class="ref-a-provider">
            <div>
              <h3 data-i18n-path="referralPage.designA.providerHeading">{t.providerHeading}</h3>
              <p>{"Jackson (" + site.soleTraderName + ")"}</p>
              <p>{site.registeredBusinessName} · {site.abnDisplay}</p>
            </div>
            <div class="ref-a-provider-print no-print"><ReferralPrintButton /></div>
          </div>
        </section>
      </div>
    </main>
    <footer class="ref-a-footer">
      <span>{publicDomain}</span>
      <a href="/privacy/" data-i18n-path="referralPage.designA.privacy">{t.privacy}</a>
    </footer>
  </div>
</BaseLayout>

<script>
  import { initHomeMotion } from "../lib/home-motion-motion";
  initHomeMotion();
  // Homepage navigation stays available, but Home is not the current page here.
  document.querySelectorAll(".ref-a .hm-header a[aria-current]").forEach((link) => {
    link.removeAttribute("aria-current");
    link.classList.remove("is-active");
  });
</script>
