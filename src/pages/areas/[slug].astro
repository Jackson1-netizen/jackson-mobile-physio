---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ShotFrame from "../../components/journal/ShotFrame.astro";
import SpokenLine from "../../components/journal/SpokenLine.astro";
import CtaPair from "../../components/journal/CtaPair.astro";
import { site } from "../../content/site";
import { suburbPages } from "../../content/suburbs";
import { journalHref } from "../../lib/journal-href";

export function getStaticPaths() {
  return suburbPages.map((suburb) => ({
    params: { slug: suburb.slug },
    props: { suburb },
  }));
}

const { suburb } = Astro.props;
const contactHref = journalHref(Astro.url.pathname, "#contact");
---

<BaseLayout title={suburb.seo.title} description={suburb.seo.description} canonicalPath={`/areas/${suburb.slug}`}>
  <article class="jc-local-page">
    <ShotFrame
      wide
      tone="olive"
      label={`Photo to be shot: a ${suburb.name} front garden in the late afternoon`}
    />
    <div class="jc-wrap jc-local">
      <p class="jc-caption">
        {site.businessName} · {site.tagline}
      </p>
      <h1>{suburb.headline}</h1>
      <SpokenLine />
      <div class="jc-measure">
        {
          suburb.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))
        }
        <ul class="jc-local-points">
          {suburb.localPoints.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
        <p>
          Consultations available in {site.languages.join(", ")}. {site.ahpraNotice}
        </p>
        <CtaPair contactHref={contactHref} />
        <p>
          <a class="jc-back" href="/#areas">← All service areas</a>
        </p>
      </div>
    </div>
  </article>
</BaseLayout>
