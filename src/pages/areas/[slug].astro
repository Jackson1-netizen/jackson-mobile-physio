---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ConceptFArea from "../../components/concept-f/Area.astro";
import { suburbPages } from "../../content/suburbs";

export function getStaticPaths() {
  return suburbPages.map((suburb) => ({
    params: { slug: suburb.slug },
    props: { suburb },
  }));
}

const { suburb } = Astro.props;
---

<BaseLayout
  translatable={true}
  title={suburb.seo.title}
  description={suburb.seo.description}
  canonicalPath={`/areas/${suburb.slug}`}
>
  <ConceptFArea suburb={suburb} />
</BaseLayout>
