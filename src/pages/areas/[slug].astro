---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RoofSuburb from "../../components/concept-d/RoofSuburb.astro";
import { suburbPages } from "../../content/suburbs";

export function getStaticPaths() {
  return suburbPages.map((suburb) => ({
    params: { slug: suburb.slug },
    props: { suburb },
  }));
}

const { suburb } = Astro.props;
---

<BaseLayout title={suburb.seo.title} description={suburb.seo.description} canonicalPath={`/areas/${suburb.slug}`} translatable={true}>
  <RoofSuburb suburb={suburb} />
</BaseLayout>
