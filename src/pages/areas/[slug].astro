---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { messages } from "../../content/i18n";
import { site } from "../../content/site";
import { suburbPages } from "../../content/suburbs";

export function getStaticPaths() {
  return suburbPages.map((suburb) => ({
    params: { slug: suburb.slug },
    props: { suburb },
  }));
}

const { suburb } = Astro.props;
const sectionNo = ["01", "02", "03"] as const;
---

<BaseLayout title={suburb.seo.title} description={suburb.seo.description} canonicalPath={`/areas/${suburb.slug}`}>
  <article class="qb-docpage">
    <div class="qb-wrap">
      <nav class="qb-crumb" aria-label="Breadcrumb">
        <a href="/">{messages.en.nav.home}</a>
        <span aria-hidden="true">/</span>
        <a href="/#areas">{messages.en.sections.areas}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{suburb.name}</span>
      </nav>
      <h1 class="qb-h1">{suburb.headline}</h1>
      <ol class="qb-doc-sections">
        <li>
          <span class="qb-idx">{sectionNo[0]}</span>
          <div>
            {suburb.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </li>
        <li>
          <span class="qb-idx">{sectionNo[1]}</span>
          <ul class="qb-points">
            {suburb.localPoints.map((point) => <li>{point}</li>)}
          </ul>
        </li>
        <li>
          <span class="qb-idx">{sectionNo[2]}</span>
          <p>
            Consultations available in {site.languages.join(", ")}. {site.ahpraNotice}
          </p>
        </li>
      </ol>
      <div class="qb-doc-actions">
        <a class="qb-btn" href="/#contact">
          {messages.en.home.primaryCta}
        </a>
        <a class="qb-textlink" href={site.phoneHref}>{site.phone}</a>
      </div>
      <p class="qb-back">
        <a class="qb-textlink" href="/#areas">{messages.en.areas.allAreas}</a>
      </p>
    </div>
  </article>
</BaseLayout>
