---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StoneSuburb from "../../components/concept-e/StoneSuburb.astro";
import { site } from "../../content/site";
import { suburbPages } from "../../content/suburbs";

export function getStaticPaths() {
  return suburbPages.map((suburb) => ({
    params: { slug: suburb.slug },
    props: { suburb },
  }));
}

const { suburb } = Astro.props;
---

<BaseLayout title={suburb.seo.title} description={suburb.seo.description} canonicalPath={`/areas/${suburb.slug}`}>
  {suburb.slug === "box-hill" ? (
    <StoneSuburb suburb={suburb} />
  ) : (
  <article class="mx-auto max-w-3xl px-4 py-14">
    <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-accent)]">
      {site.businessName} · {site.tagline}
    </p>
    <h1 class="mt-3 font-serif text-4xl font-bold text-[var(--color-ink)]">{suburb.headline}</h1>
    <div class="prose-width mt-6 space-y-4 text-lg leading-relaxed text-[var(--color-ink-muted)]">
      {suburb.paragraphs.map((p) => (
        <p>{p}</p>
      ))}
    </div>
    <ul class="mt-8 space-y-2 rounded-lg border border-[var(--color-border)] bg-white p-6 text-[var(--color-ink-muted)]">
      {suburb.localPoints.map((point) => (
        <li class="flex gap-2">
          <span class="text-[var(--color-accent)]" aria-hidden="true">•</span>
          <span>{point}</span>
        </li>
      ))}
    </ul>
    <p class="mt-6 text-sm text-[var(--color-ink-muted)]">
      Consultations available in {site.languages.join(", ")}. {site.ahpraNotice}
    </p>
    <div class="mt-10 flex flex-col gap-3 sm:flex-row">
      <a
        href={site.phoneHref}
        class="inline-flex items-center justify-center rounded-md bg-[var(--color-accent)] px-6 py-3 font-semibold text-white no-underline hover:bg-[var(--color-accent-hover)]"
      >
        Call {site.phone}
      </a>
      <a
        href="/#contact"
        class="inline-flex items-center justify-center rounded-md border border-[var(--color-border)] bg-white px-6 py-3 font-semibold no-underline hover:border-[var(--color-accent)]"
      >
        Send an enquiry
      </a>
    </div>
    <p class="mt-10 text-sm">
      <a class="text-[var(--color-accent)] underline-offset-4 hover:underline" href="/">
        ← All service areas
      </a>
    </p>
  </article>
  )}
</BaseLayout>
