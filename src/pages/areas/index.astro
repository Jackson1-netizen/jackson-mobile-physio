---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EnquiryBanner from "../../components/home/EnquiryBanner.astro";
import HomeAreas from "../../components/home/HomeAreas.astro";
import { site } from "../../content/site";
import { homeAreas } from "../../content/home-motion";
---

<BaseLayout
  translatable={true}
  canonicalPath="/areas"
  title={`Service areas | ${site.businessName}${site.draft ? " (draft)" : ""}`}
  description={homeAreas.lead}
>
  <HomeAreas pageHeading={true} />
  <EnquiryBanner />
</BaseLayout>
