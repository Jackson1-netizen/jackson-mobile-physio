---
import ConceptLayout from "../../../layouts/ConceptLayout.astro";
---

<ConceptLayout
  concept={2}
  title="Concept 2 — Warm Meadow (homepage mockup)"
  description="Homepage visual concept: warmer cream palette, centred calm hierarchy, lower interaction density."
>
  <Fragment slot="head">
    <style>
      .c2 {
        --ink: #1f2d28;
        --muted: #4a5c55;
        --cream: #f8f4ec;
        --warm: #f0e8da;
        --white: #fffcf7;
        --accent: #356b58;
        --accent-soft: #4d8872;
        --border: #ddd2c4;
        font-family: "Source Sans 3", system-ui, sans-serif;
        color: var(--ink);
        background: var(--cream);
        font-size: 1.125rem;
        line-height: 1.65;
      }
      .c2 h1,
      .c2 h2 {
        font-family: "Source Serif 4", Georgia, serif;
        font-weight: 600;
      }
      .c2 header {
        background: var(--white);
        border-bottom: 1px solid var(--border);
      }
      .c2 .shell {
        max-width: 40rem;
        margin: 0 auto;
        padding: 0 1.35rem;
      }
      .c2 .shell-wide {
        max-width: 52rem;
        margin: 0 auto;
        padding: 0 1.35rem;
      }
      .c2 .top {
        text-align: center;
        padding: 1rem 0;
        font-size: 1rem;
      }
      .c2 .top a {
        color: var(--accent);
        font-weight: 700;
        text-decoration: none;
      }
      .c2 .hero {
        text-align: center;
        padding: 3rem 0 3.5rem;
        background: linear-gradient(180deg, var(--white) 0%, var(--cream) 100%);
      }
      .c2 .region {
        font-size: 0.85rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--accent-soft);
        font-weight: 700;
      }
      .c2 h1 {
        font-size: clamp(2rem, 6vw, 3.25rem);
        line-height: 1.12;
        margin: 1rem auto 0;
        max-width: 22ch;
      }
      .c2 .sub {
        margin: 1.25rem auto 0;
        max-width: 36ch;
        color: var(--muted);
        font-size: 1.2rem;
      }
      .c2 .lang-row {
        margin-top: 1.5rem;
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        flex-wrap: wrap;
      }
      .c2 .lang-row button {
        font: inherit;
        cursor: default;
        padding: 0.4rem 0.9rem;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: var(--white);
      }
      .c2 .lang-row button.active {
        background: var(--accent);
        color: #fff;
        border-color: var(--accent);
      }
      .c2 .cta-stack {
        margin-top: 2rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        align-items: center;
      }
      .c2 .cta {
        display: block;
        width: min(100%, 18rem);
        text-align: center;
        padding: 1rem 1.25rem;
        border-radius: 12px;
        font-weight: 700;
        text-decoration: none;
        font-size: 1.1rem;
      }
      .c2 .cta-main {
        background: var(--accent);
        color: #fff;
      }
      .c2 .cta-alt {
        background: transparent;
        border: 2px solid var(--accent);
        color: var(--accent);
      }
      .c2 .frame {
        margin: 2.5rem auto 0;
        max-width: 28rem;
        aspect-ratio: 4/3;
        border-radius: 20px;
        background: var(--warm);
        border: 1px solid var(--border);
        display: grid;
        place-items: center;
        padding: 1rem;
        color: var(--muted);
        font-size: 1rem;
      }
      .c2 .facts {
        margin-top: 2rem;
        padding: 1.25rem;
        background: #fff9f0;
        border-radius: 12px;
        border: 1px solid #e8dcc8;
        text-align: left;
        font-size: 1.05rem;
      }
      .c2 .facts li {
        margin: 0.35rem 0;
      }
      .c2 section {
        padding: 3.5rem 0;
      }
      .c2 .block {
        background: var(--white);
        border-radius: 16px;
        border: 1px solid var(--border);
        padding: 1.75rem;
        margin-bottom: 1rem;
      }
      .c2 .block h3 {
        font-family: "Source Serif 4", serif;
        margin: 0 0 0.5rem;
        font-size: 1.35rem;
      }
      .c2 .block p {
        margin: 0;
        color: var(--muted);
      }
      .c2 .sticky-call {
        display: none;
      }
      @media (max-width: 639px) {
        .c2 .sticky-call {
          display: block;
          position: fixed;
          bottom: 0;
          left: 0;
          right: 0;
          text-align: center;
          background: var(--accent);
          color: #fff;
          padding: 1rem;
          font-weight: 700;
          text-decoration: none;
          z-index: 40;
        }
        .c2 {
          padding-bottom: 3.5rem;
        }
      }
    </style>
  </Fragment>

  <div class="c2" id="main">
    <header>
      <div class="shell-wide top">
        <span>Jackson · Mobile Physio</span> · <a href="tel:+61433479703">0433 479 703</a>
      </div>
    </header>

    <section class="hero">
      <div class="shell">
        <p class="region">Melbourne eastern suburbs</p>
        <h1>Mobile physiotherapy in Melbourne&rsquo;s eastern suburbs</h1>
        <p class="sub">One physiotherapist, one conversation — Jackson is who you speak with, and who visits you at home.</p>
        <div class="lang-row" aria-label="Languages">
          <button type="button" class="active">English</button>
          <button type="button">粵語</button>
          <button type="button">普通话</button>
        </div>
        <div class="cta-stack">
          <a class="cta cta-main" href="tel:+61433479703">Call 0433 479 703</a>
          <a class="cta cta-alt" href="#enquire">Send an enquiry</a>
        </div>
        <div class="frame">
          Warm photography placeholder — portrait after real shoot only
        </div>
        <ul class="facts">
          <li>English, Cantonese, and Mandarin</li>
          <li>NDIS plan-managed & self-managed enquiries welcome</li>
          <li>Not an NDIS registered provider</li>
          <li>AHPRA registration pending (draft site)</li>
        </ul>
      </div>
    </section>

    <section>
      <div class="shell-wide">
        <h2 style="text-align: center; font-size: 1.85rem; margin: 0 0 2rem;">Support that fits real life</h2>
        <div class="block">
          <h3>Mobility at home</h3>
          <p>Movement and confidence in the places you actually live — not a gym programme.</p>
        </div>
        <div class="block">
          <h3>Balance & falls awareness</h3>
          <p>Practical strategies discussed with you and your supports.</p>
        </div>
        <div class="block">
          <h3>Community goals</h3>
          <p>Getting to shops, family visits, and local outings when that matters to you.</p>
        </div>
      </div>
    </section>

    <section id="enquire" style="background: var(--warm);">
      <div class="shell" style="text-align: center;">
        <h2 style="font-size: 1.75rem;">Gentle next step</h2>
        <p style="color: var(--muted);">Lower visual noise — fewer interactive elements per screen, larger tap targets.</p>
        <a class="cta cta-main" href="tel:+61433479703" style="margin: 1.5rem auto 0;">Talk with Jackson</a>
      </div>
    </section>

    <a class="sticky-call" href="tel:+61433479703">Call · 0433 479 703</a>
  </div>
</ConceptLayout>
