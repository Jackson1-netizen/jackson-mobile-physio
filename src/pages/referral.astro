---
import BaseLayout from "../layouts/BaseLayout.astro";
import ReferralExperience from "../components/ReferralExperience.astro";
import { site } from "../content/site";
import { messages } from "../content/i18n";
---

<BaseLayout
  translatable
  i18nInclude={["nav", "cta", "sections", "home", "hm", "referralForm"]}
  canonicalPath="/referral"
  title={`Make a Referral | ${site.businessName}`}
  description={messages.en.referralForm.welcome}
>
  <ReferralExperience />
</BaseLayout>
