---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, formatServiceAreasLine, getReferralEmailHref } from "../content/site";

const serviceList = site.services.map((s) => s.title).join("; ");
const serviceAreaLine = formatServiceAreasLine();
const referralMailto = getReferralEmailHref();
---

<BaseLayout
  title={`Referral sheet | ${site.businessName}`}
  description="Printable referral information for support coordinators and families (draft)."
  canonicalPath="/referral"
>
  <div class="referral-sheet mx-auto max-w-[210mm] bg-white px-6 py-8 text-[var(--color-ink)] sm:px-10 sm:py-12">
    <p class="no-print mb-6 rounded border border-amber-200 bg-[var(--color-draft-bg)] p-3 text-sm text-[var(--color-draft)]">
      Referral sheet — AHPRA registration granted. Confirm contact details before printing. Use your browser&apos;s Print command (Ctrl+P / ⌘P).
    </p>

    <header class="border-b border-[var(--color-border)] pb-6">
      <p class="text-xs font-semibold uppercase tracking-wider text-[var(--color-accent)]">Referral information</p>
      <h1 class="mt-2 font-serif text-3xl font-bold">{site.businessName}</h1>
      <p class="mt-1 text-xl font-semibold tracking-wide text-[var(--color-ink)]">{site.tagline}</p>
      <p class="text-lg text-[var(--color-ink-muted)]">{site.locationDescriptor}</p>
    </header>

    <div class="mt-6 grid gap-8 sm:grid-cols-[1fr_auto]">
      <div class="space-y-6 text-sm leading-relaxed">
        <section>
          <h2 class="font-serif text-lg font-semibold">Practitioner</h2>
          <p class="mt-1">{site.practitionerName}</p>
          <ul class="mt-2 list-none space-y-1 text-[var(--color-ink-muted)]">
            {site.qualifications.map((q) => (
              <li><span class="text-[var(--color-ink)]">{q.label}:</span> {q.value}</li>
            ))}
          </ul>
          <p class="mt-2 text-[var(--color-ink-muted)]">{site.ahpraNotice}</p>
        </section>

        <section>
          <h2 class="font-serif text-lg font-semibold">Service model</h2>
          <p class="mt-1">Independent mobile / home / community physiotherapy.</p>
          <p class="mt-2">{site.differentiator}</p>
        </section>

        <section>
          <h2 class="font-serif text-lg font-semibold">Service areas</h2>
          <p class="mt-1">{serviceAreaLine}</p>
        </section>

        <section>
          <h2 class="font-serif text-lg font-semibold">Languages</h2>
          <p class="mt-1">{site.languages.join(", ")}</p>
        </section>

        <section>
          <h2 class="font-serif text-lg font-semibold">Example services (non-exhaustive)</h2>
          <p class="mt-1">{serviceList}</p>
          <p class="mt-2 text-[var(--color-ink-muted)]">{site.servicesIntro}</p>
        </section>

        <section>
          <h2 class="font-serif text-lg font-semibold">NDIS</h2>
          <p class="mt-1">{site.ndisDescription}</p>
        </section>

        <section>
          <h2 class="font-serif text-lg font-semibold">Contact</h2>
          <p class="mt-1">Phone: {site.phone}</p>
          <p>Email: <a href={referralMailto}>{site.referralEmail}</a></p>
        </section>
      </div>

      <aside class="flex flex-col items-center justify-start text-center" aria-label="QR code placeholder">
        <div
          class="flex h-32 w-32 items-center justify-center border-2 border-dashed border-[var(--color-border)] bg-[var(--color-surface)] text-xs text-[var(--color-ink-muted)]"
          role="img"
          aria-label="QR code placeholder — add when a public website URL is confirmed for display"
        >
          QR placeholder
        </div>
        <p class="mt-2 max-w-[8rem] text-xs text-[var(--color-ink-muted)]">Add when URL confirmed for print</p>
      </aside>
    </div>

    <footer class="mt-10 border-t border-[var(--color-border)] pt-4 text-xs text-[var(--color-ink-muted)]">
      {site.draftNotice.title}. {site.abnDisplay}. Not for emergency use.
    </footer>
  </div>
</BaseLayout>

<style>
  @media print {
    @page {
      size: A4;
      margin: 12mm;
    }

    .referral-sheet {
      max-width: none;
      padding: 0;
    }
  }
</style>
