---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../content/site";
---

<BaseLayout
  title={`If you've just sent an enquiry | ${site.businessName}`}
  description="This page is shown after the Home Motion enquiry form. Opening it on its own does not send an enquiry."
  canonicalPath="/enquiry-received"
>
  <article class="mx-auto max-w-3xl px-6 py-14">
    <h1 class="font-serif text-3xl font-bold text-[var(--color-ink)]">If you've just sent an enquiry, thank you</h1>
    <p class="mt-6 text-lg leading-relaxed text-[var(--color-ink-muted)]">
      If you've just sent an enquiry, thank you. Jackson will be in touch when he has your message. Opening this page
      directly does not send an enquiry, and sending the form does not start treatment. If you need to reach him sooner,
      call <a class="font-semibold text-[var(--color-ink)] underline underline-offset-4" href={site.phoneHref}>{site.phone}</a>.
    </p>
    <p class="mt-6 text-sm">
      <a class="text-[var(--color-accent)] underline-offset-4 hover:underline" href="/">Back to home</a>
    </p>
  </article>
</BaseLayout>
