---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../content/site";
---

<BaseLayout
  title={`${site.privacy.pageTitle} | ${site.businessName}`}
  description={site.privacy.metaDescription}
  canonicalPath="/privacy"
>
  <article class="mx-auto max-w-3xl px-4 py-14">
    <h1 class="font-serif text-3xl font-bold text-[var(--color-ink)]">{site.privacy.pageTitle}</h1>
    <p class="mt-2 text-sm text-[var(--color-ink-muted)]">
      {site.privacy.lastUpdatedLabel} {site.privacy.lastUpdated}
    </p>

    <div class="mt-10 space-y-4 text-[var(--color-ink-muted)] leading-relaxed">
      {site.privacy.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <p>
        {site.privacy.privacyEnquiriesContactLabel}{" "}
        <a class="font-medium text-[var(--color-ink)] underline underline-offset-4" href={`mailto:${site.publicEmail}`}>
          {site.publicEmail}
        </a>
      </p>
    </div>

    <p class="mt-10 rounded-md border border-amber-200 bg-[var(--color-draft-bg)] p-4 text-sm text-[var(--color-draft)]">
      {site.privacy.workingDraftNotice}
    </p>

    <p class="mt-10 text-sm">
      <a class="text-[var(--color-accent)] underline-offset-4 hover:underline" href="/">← Back to home</a>
    </p>
  </article>
</BaseLayout>
