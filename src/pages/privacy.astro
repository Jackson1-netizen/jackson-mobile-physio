---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../content/site";
---

<BaseLayout
  title={`${site.privacy.pageTitle} | ${site.businessName}`}
  description="Draft privacy policy for WAI WA LAW mobile physiotherapy (development site)."
  canonicalPath="/privacy"
>
  <article class="mx-auto max-w-3xl px-4 py-14">
    <h1 class="font-serif text-3xl font-bold text-[var(--color-ink)]">{site.privacy.pageTitle}</h1>
    <p class="mt-2 text-sm text-[var(--color-ink-muted)]">Last updated: {site.privacy.lastUpdated}</p>
    <p class="mt-4 rounded-md border border-amber-200 bg-[var(--color-draft-bg)] p-4 text-sm text-[var(--color-draft)]">
      {site.privacy.workingDraftNotice}
    </p>

    <div class="mt-10 space-y-10 text-[var(--color-ink-muted)] leading-relaxed">
      {site.privacy.sections.map((section) => (
        <section>
          <h2 class="font-serif text-xl font-semibold text-[var(--color-ink)]">{section.heading}</h2>
          <div class="mt-3 space-y-3">
            {section.paragraphs.map((p) => (
              <p>{p}</p>
            ))}
            {section.heading === "Contact for privacy" && (
              <p class="font-medium text-[var(--color-ink)]">{site.email}</p>
            )}
          </div>
        </section>
      ))}
    </div>

    <p class="mt-10 text-sm">
      <a class="text-[var(--color-accent)] underline-offset-4 hover:underline" href="/">← Back to home</a>
    </p>
  </article>
</BaseLayout>
