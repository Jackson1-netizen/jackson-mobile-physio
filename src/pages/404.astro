---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../content/site";
---

<BaseLayout title={`Page not found | ${site.businessName}`} description="That page is not on the Home Motion website." canonicalPath={false} noindex>
  <article class="mx-auto max-w-3xl px-6 py-14">
    <h1 class="font-serif text-3xl font-bold text-[var(--color-ink)]">Page not found</h1>
    <p class="mt-6 text-lg leading-relaxed text-[var(--color-ink-muted)]">
      That address is not on this website. <a class="font-semibold text-[var(--color-ink)] underline underline-offset-4" href="/">Back to home</a>.
    </p>
  </article>
</BaseLayout>
