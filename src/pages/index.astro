---
import BaseLayout from "../layouts/BaseLayout.astro";
import JournalHome from "../components/journal/JournalHome.astro";
import { site } from "../content/site";
---

<BaseLayout
  translatable={true}
  includeFaqSchema={true}
  canonicalPath="/"
  title={`${site.seo.defaultTitle}${site.draft ? " (draft)" : ""}`}
  description={site.seo.description}
>
  <JournalHome />
</BaseLayout>
