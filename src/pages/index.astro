---
import BaseLayout from "../layouts/BaseLayout.astro";
import QuietHome from "../components/home/QuietHome.astro";
import { site } from "../content/site";
---

<BaseLayout
  translatable={true}
  includeFaqSchema={true}
  canonicalPath="/"
  title={`${site.seo.defaultTitle}${site.draft ? " (draft)" : ""}`}
  description={site.seo.description}
>
  <QuietHome />
</BaseLayout>
