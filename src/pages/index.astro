---
import BaseLayout from "../layouts/BaseLayout.astro";
import RoofHome from "../components/concept-d/RoofHome.astro";
import { site } from "../content/site";
---

<BaseLayout
  v1Home={true}
  translatable={true}
  includeFaqSchema={true}
  canonicalPath="/"
  title={`${site.seo.defaultTitle}${site.draft ? " (draft)" : ""}`}
  description={site.seo.description}
>
  <RoofHome />
</BaseLayout>
