---
import BaseLayout from "../layouts/BaseLayout.astro";
import StoneHome from "../components/concept-e/StoneHome.astro";
import { site } from "../content/site";
---

<BaseLayout
  translatable={true}
  includeFaqSchema={true}
  canonicalPath="/"
  title={`${site.seo.defaultTitle}${site.draft ? " (draft)" : ""}`}
  description={site.seo.description}
>
  <StoneHome />
</BaseLayout>
