---
import BaseLayout from "../layouts/BaseLayout.astro";
import ConceptFHome from "../components/concept-f/Home.astro";
import { site } from "../content/site";
---

<BaseLayout
  translatable={true}
  includeFaqSchema={true}
  canonicalPath="/"
  title={`${site.seo.defaultTitle}${site.draft ? " (draft)" : ""}`}
  description={site.seo.description}
>
  <ConceptFHome />
</BaseLayout>
