---
import { messages } from "../content/i18n";
---

<button class="ref-a-print" type="button" data-referral-print hidden>
  <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M7 8V3h10v5M7 17H4V9h16v8h-3" />
    <path d="M7 14h10v7H7zM16 11h1" />
  </svg>
  <span data-i18n-path="referralPage.designA.print">{messages.en.referralPage.designA.print}</span>
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-referral-print]").forEach((button) => {
    button.hidden = false;
    button.addEventListener("click", () => window.print());
  });
</script>
