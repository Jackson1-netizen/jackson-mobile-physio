---
import { site } from "../content/site";
import { suburbPages, suburbPath } from "../content/suburbs";
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-border)] bg-[var(--color-ink)] text-[var(--color-surface)]">
  <div class="mx-auto max-w-5xl px-4 py-10 text-sm leading-relaxed">
    <div class="grid gap-10 lg:grid-cols-[1.2fr_1fr]">
      <div>
        <p class="font-serif text-lg font-semibold">{site.businessName}</p>
        <p class="mt-2 text-white/80">
          {site.registeredBusinessName} · {site.soleTraderName}, sole trader
        </p>
        <p class="mt-4">
          <a class="text-white underline underline-offset-4" href={site.phoneHref}>
            {site.phone}
          </a>
          <span class="mx-2 text-white/50" aria-hidden="true">·</span>
          <a class="text-white underline underline-offset-4" href={site.emailHref}>
            {site.publicEmail}
          </a>
        </p>
        <p class="mt-2 text-white/70">{site.abnDisplay}</p>
        <p class="mt-2 text-white/70">AHPRA {site.ahpraRegistrationNumber}</p>
        <p class="mt-4 text-white/60">{site.ahpraNotice}</p>
      </div>
      <div>
        <p class="font-semibold text-white/90" data-i18n-path="sections.areas">Service areas</p>
        <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1 text-white/75">
          {suburbPages.map((suburb) => (
            <li>
              <a class="hover:text-white hover:underline" href={suburbPath(suburb.slug)}>
                {suburb.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <p class="mt-8">
      <a class="text-white/80 underline-offset-4 hover:text-white hover:underline" href="/privacy">
        {site.footer.privacyLinkLabel}
      </a>
      <span class="mx-2 text-white/40" aria-hidden="true">·</span>
      <a class="text-white/80 underline-offset-4 hover:text-white hover:underline" href="/disclaimer">
        {site.footer.disclaimerLinkLabel}
      </a>
      <span class="mx-2 text-white/40" aria-hidden="true">·</span>
      <a class="text-white/80 underline-offset-4 hover:text-white hover:underline" href="/referral">
        <span data-i18n-path="nav.referralSheet">Referral sheet</span>
      </a>
    </p>
    <p class="mt-6 text-white/50">
      © {year} {site.businessName}. {site.footer.copyrightSuffix}
    </p>
  </div>
</footer>
