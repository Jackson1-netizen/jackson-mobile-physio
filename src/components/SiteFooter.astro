---
import { site } from "../content/site";
import { messages } from "../content/i18n";
import { suburbPages, suburbPath } from "../content/suburbs";

const year = new Date().getFullYear();
---

<footer class="a-footer">
  <div class="a-wrap a-footer-grid">
    <div>
      <p class="a-footer-brand" translate="no">{site.businessName}</p>
      <p>
        {site.registeredBusinessName} · {site.soleTraderName}, sole trader
      </p>
      <p class="a-footer-contact">
        <a href={site.phoneHref} translate="no">{site.phone}</a>
      </p>
      <p class="a-footer-contact">
        <a href={site.emailHref}>{site.publicEmail}</a>
      </p>
      <p translate="no">{site.abnDisplay}</p>
    </div>
    <nav aria-label={messages.en.sections.areas}>
      <p data-i18n-path="sections.areas">{messages.en.sections.areas}</p>
      <ul class="a-footer-links">
        {
          suburbPages.map((suburb) => (
            <li>
              <a href={suburbPath(suburb.slug)}>{suburb.name}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="a-wrap">
    <ul class="a-footer-legal">
      <li>
        <a href="/privacy/" data-i18n-path="hm.footer.privacy">{site.footer.privacyLinkLabel}</a>
      </li>
      <li>
        <a href="/disclaimer/" data-i18n-path="hm.footer.disclaimer">{site.footer.disclaimerLinkLabel}</a>
      </li>
      <li>
        <a href="/referral/" data-i18n-path="nav.referralSheet">{messages.en.nav.referralSheet}</a>
      </li>
    </ul>
    <p>
      © {year} <span translate="no">{site.businessName}</span>.{" "}
      <span data-i18n-path="hm.footer.rights">{site.footer.copyrightSuffix}</span>
    </p>
  </div>
</footer>
