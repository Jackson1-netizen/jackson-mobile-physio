---
import HomeLogo from "./home/HomeLogo.astro";
import HomeIcon from "./home/HomeIcon.astro";
import { site, getEmailHref } from "../content/site";
import { messages } from "../content/i18n";

interface Props {
  /** Homepage mobile bar is fixed, so the footer clears it below 1024px. */
  reserveMobileBar?: boolean;
  /** The approved referral form has its own responsive footer composition. */
  referralForm?: boolean;
}

const { reserveMobileBar = false, referralForm = false } = Astro.props;
const year = new Date().getFullYear();
const mailto = getEmailHref();
const copy = messages.en.hm.footer;
---

<footer class:list={["site-footer", reserveMobileBar && "site-footer-home", referralForm && "site-footer-referral"]}>
  <div class="site-footer-wrap">
    <div class="site-footer-grid">
      <div class="site-footer-brand">
        <a
          class="site-footer-logo"
          href="/"
          aria-label={messages.en.hm.header.logoLabel}
          data-i18n-attr="aria-label:hm.header.logoLabel"
        >
          <HomeLogo sizes="200px" alt="" lazy />
        </a>
        <p class="site-footer-tagline" data-i18n-path="hm.footer.tagline">{copy.tagline}</p>
        <p class="site-footer-tagline-small" data-i18n-path="hm.footer.taglineSmall">{copy.taglineSmall}</p>
      </div>

      <nav class="site-footer-col" aria-labelledby="footer-explore">
        <h2 id="footer-explore" data-i18n-path="hm.footer.explore">{copy.explore}</h2>
        <ul>
          <li>
            <a href="/#how" data-i18n-path="sections.howItWorks">{messages.en.sections.howItWorks}</a>
          </li>
          {!referralForm && <li>
            <a href="/areas/" data-i18n-path="sections.areas">{messages.en.sections.areas}</a>
          </li>}
          <li>
            <a href="/referral/" data-i18n-path={referralForm ? "referralForm.formLabel" : "nav.referralSheet"}>{referralForm ? "Referral form" : messages.en.nav.referralSheet}</a>
          </li>
        </ul>
      </nav>

      <nav class="site-footer-col" aria-labelledby="footer-information">
        <h2 id="footer-information" data-i18n-path="hm.footer.information">{copy.information}</h2>
        <ul>
          <li>
            <a href="/privacy/"><span class="hm-mobile-approved-desktop" data-i18n-path="hm.footer.privacy">{copy.privacy}</span><span class="hm-mobile-approved-only" data-i18n-path="hm.mobileApproved.privacy">{messages.en.hm.mobileApproved.privacy}</span></a>
          </li>
          <li>
            <a href="/disclaimer/"><span class="hm-mobile-approved-desktop" data-i18n-path="hm.footer.disclaimer">{copy.disclaimer}</span><span class="hm-mobile-approved-only" data-i18n-path="hm.mobileApproved.disclaimer">{messages.en.hm.mobileApproved.disclaimer}</span></a>
          </li>
        </ul>
      </nav>

      <div class="site-footer-col">
        <h2 data-i18n-path="sections.contact">{messages.en.sections.contact}</h2>
        <ul class="site-footer-contact">
          <li>
            <a href={site.phoneHref}>
              <HomeIcon name="phone" size={18} />
              <span>{site.phone}</span>
            </a>
          </li>
          <li>
            <a href={mailto}>
              <HomeIcon name="mail" size={18} />
              <span>{site.publicEmail}</span>
            </a>
          </li>
        </ul>
        <p class="site-footer-languages" data-i18n-path="hm.footer.languages">{copy.languages}</p>
      </div>
    </div>

    <div class="site-footer-bottom">
      <p class="site-footer-copy">
        <span>© {year} {site.registeredBusinessName}. </span>
        <span data-i18n-path="hm.footer.rights">{copy.rights}</span>
      </p>
      <p class="site-footer-abn">{site.abnDisplay}</p>
    </div>
    <p class="site-footer-compliance" data-i18n-path="hm.footer.compliance">{copy.compliance}</p>
  </div>
</footer>

<style>
  .site-footer {
    --ft-bg: #e7ede4;
    --ft-rule: #0c312a;
    --ft-heading: #10342e;
    --ft-tagline: #1f453d;
    --ft-muted: #4e6969;
    --ft-line: #9fafaa;
    --ft-plate: #fbfaf8;
    background: var(--ft-bg);
    border-top: 1px solid var(--ft-rule);
    color: var(--ft-heading);
    font-family: "Source Sans 3", "Source Sans 3 Fallback", "PingFang TC", "PingFang SC", "Noto Sans TC", "Noto Sans SC", "Microsoft JhengHei", "Microsoft YaHei", system-ui, sans-serif;
    font-size: 1rem;
    line-height: 1.45;
    padding: 2.6rem 0 1.65rem;
  }

  .site-footer-home {
    padding-bottom: calc(1.65rem + 3.25rem + env(safe-area-inset-bottom, 0px));
  }

  .site-footer-wrap {
    width: min(72rem, calc(100% - 2.5rem));
    margin-inline: auto;
  }

  .site-footer p {
    max-width: none;
    margin: 0;
  }

  .site-footer h2 {
    margin: 0 0 0.85rem;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.3;
    color: var(--ft-heading);
  }

  .site-footer a {
    color: var(--ft-muted);
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--ft-heading);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .site-footer a:focus-visible {
    outline: 3px solid var(--ft-heading);
    outline-offset: 3px;
  }

  .site-footer-grid {
    display: grid;
    gap: 1.75rem 2.5rem;
  }

  .site-footer-logo {
    display: inline-block;
    width: 11.5rem;
    aspect-ratio: 627 / 287;
    overflow: hidden;
    background: var(--ft-plate);
    line-height: 0;
  }

  .site-footer-logo :global(picture),
  .site-footer-logo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .site-footer-logo :global(img) {
    object-fit: cover;
    object-position: center bottom;
  }

  .site-footer-tagline {
    margin-top: 1rem;
    max-width: 18rem;
    color: var(--ft-tagline);
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .site-footer-tagline-small {
    margin-top: 0.45rem;
    max-width: 17rem;
    color: var(--ft-muted);
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.45;
  }

  .site-footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  .site-footer-col a {
    font-size: 0.9375rem;
  }

  .site-footer-contact a {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.45rem;
  }

  .site-footer-contact :global(svg) {
    flex: none;
    margin-top: 0.12rem;
  }

  .site-footer-contact span {
    overflow-wrap: anywhere;
  }

  .site-footer-languages {
    margin-top: 0.7rem;
    color: var(--ft-muted);
    font-size: 0.9375rem;
  }

  .site-footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem 1.5rem;
    flex-wrap: wrap;
    margin-top: 1.85rem;
    padding-top: 0.95rem;
    border-top: 1px solid var(--ft-line);
    color: var(--ft-muted);
    font-size: 0.8125rem;
  }

  .site-footer-abn {
    margin-left: auto;
  }

  .site-footer-compliance {
    margin-top: 0.55rem;
    color: #3e5854;
    font-size: 0.8125rem;
    line-height: 1.45;
    max-width: 62rem;
  }

  @media (min-width: 36rem) {
    .site-footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .site-footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 60rem) {
    .site-footer-grid {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.85fr) minmax(0, 0.9fr) minmax(0, 1.15fr);
      gap: 2rem 2.25rem;
    }

    .site-footer-brand {
      grid-column: auto;
    }
  }

  @media (min-width: 1024px) {
    .site-footer-home {
      padding-bottom: 1.65rem;
    }
  }

  /* Referral-only geometry follows v5_1; other routes keep their footer. */
  .site-footer-referral {
    font-family: "Referral Sans", "Source Sans 3", system-ui, sans-serif;
    padding: 42px 0 27px;
  }

  .site-footer-referral .site-footer-wrap {
    width: min(1152px, calc(100% - 64px));
  }

  .site-footer-referral .site-footer-grid {
    grid-template-columns: minmax(0, 1.35fr) minmax(0, .85fr) minmax(0, .9fr) minmax(0, 1.15fr);
    gap: 32px 36px;
  }

  .site-footer-referral .site-footer-brand {
    grid-column: auto;
  }

  .site-footer-referral .site-footer-logo {
    display: block;
    width: 184px;
    background: var(--ft-plate);
  }

  .site-footer-referral .site-footer-logo :global(img) {
    mix-blend-mode: normal;
  }

  .site-footer-referral .site-footer-tagline {
    margin-top: 16px;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
  }

  .site-footer-referral .site-footer-tagline-small {
    margin-top: 7px;
    font-size: 13px;
  }

  .site-footer-referral h2 {
    margin-bottom: 14px;
    font: 700 15px/1.3 "Referral Sans", "Source Sans 3", system-ui, sans-serif;
    letter-spacing: 0;
  }

  .site-footer-referral .site-footer-col ul {
    gap: 8px;
  }

  .site-footer-referral .site-footer-col a {
    font-size: 15px;
  }

  .site-footer-referral .site-footer-contact a {
    display: flex;
    gap: 8px;
  }

  .site-footer-referral .site-footer-contact :global(svg) {
    width: 17px;
    height: 17px;
    margin-top: 2px;
  }

  .site-footer-referral .site-footer-languages {
    margin-top: 11px;
    font-size: 15px;
  }

  .site-footer-referral .site-footer-bottom {
    margin-top: 30px;
    padding-top: 15px;
    gap: 12px 24px;
    font-size: 13px;
  }

  .site-footer-referral .site-footer-compliance {
    margin-top: 9px;
    font-size: 13px;
  }

  @media (max-width: 1150px) {
    .site-footer-referral .site-footer-grid {
      grid-template-columns: 1.2fr .7fr .7fr 1.2fr;
      gap: 24px;
    }
    .site-footer-referral .site-footer-contact a {
      font-size: 14px;
    }
  }

  @media (max-width: 900px) {
    .site-footer-referral .site-footer-wrap {
      width: calc(100% - 40px);
    }
    .site-footer-referral .site-footer-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 28px;
    }
    .site-footer-referral .site-footer-brand {
      grid-column: 1 / -1;
      max-width: 420px;
    }
    .site-footer-referral .site-footer-col:last-child {
      grid-column: 1 / -1;
      padding-top: 20px;
      border-top: 1px solid #bdcabc;
    }
    .site-footer-referral .site-footer-contact a {
      font-size: 15px;
    }
  }

  @media (max-width: 600px) {
    .site-footer-referral {
      padding: 32px 0 24px;
    }
    .site-footer-referral .site-footer-wrap {
      width: calc(100% - 32px);
    }
    .site-footer-referral .site-footer-grid {
      gap: 26px 20px;
    }
    .site-footer-referral .site-footer-logo {
      width: 150px;
    }
    .site-footer-referral .site-footer-tagline {
      font: 560 23px/1.2 "Referral Serif", "Source Serif 4", Georgia, serif;
      letter-spacing: -.025em;
    }
    .site-footer-referral .site-footer-tagline-small {
      margin-top: 8px;
    }
    .site-footer-referral .site-footer-col h2 {
      margin-bottom: 13px;
      font: 560 21px/1.2 "Referral Serif", "Source Serif 4", Georgia, serif;
      letter-spacing: -.02em;
    }
    .site-footer-referral .site-footer-col ul {
      gap: 12px;
    }
    .site-footer-referral .site-footer-col li > a {
      display: inline;
      min-height: 0;
      font-size: 15px;
    }
    .site-footer-referral .site-footer-contact li > a {
      display: flex;
      min-height: 0;
    }
    .site-footer-referral .site-footer-contact :global(svg) {
      color: inherit;
    }
    .site-footer-referral .site-footer-languages {
      font-size: 15px;
    }
    .site-footer-referral .site-footer-bottom {
      display: block;
      margin-top: 24px;
      padding-top: 15px;
      font-size: 13px;
    }
    .site-footer-referral .site-footer-copy,
    .site-footer-referral .site-footer-abn {
      display: block;
    }
    .site-footer-referral .site-footer-copy span:first-child {
      display: inline;
    }
    .site-footer-referral .site-footer-abn {
      margin: 4px 0 0;
    }
    .site-footer-referral .site-footer-compliance {
      margin-top: 10px;
      font-size: 12px;
      line-height: 1.55;
    }
  }
</style>
