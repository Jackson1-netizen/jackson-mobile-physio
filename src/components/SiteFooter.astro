---
import HomeLogo from "./home/HomeLogo.astro";
import HomeIcon from "./home/HomeIcon.astro";
import { site, getEmailHref } from "../content/site";
import { messages } from "../content/i18n";

interface Props {
  /** Homepage mobile bar is fixed, so the footer clears it below 1024px. */
  reserveMobileBar?: boolean;
}

const { reserveMobileBar = false } = Astro.props;
const year = new Date().getFullYear();
const mailto = getEmailHref();
const copy = messages.en.hm.footer;
---

<footer class:list={["site-footer", reserveMobileBar && "site-footer-home"]}>
  <div class="site-footer-wrap">
    <div class="site-footer-grid">
      <div class="site-footer-brand">
        <a
          class="site-footer-logo"
          href="/"
          aria-label={messages.en.hm.header.logoLabel}
          data-i18n-attr="aria-label:hm.header.logoLabel"
        >
          <HomeLogo sizes="200px" alt="" lazy />
        </a>
        <p class="site-footer-tagline" data-i18n-path="hm.footer.tagline">{copy.tagline}</p>
        <p class="site-footer-tagline-small" data-i18n-path="hm.footer.taglineSmall">{copy.taglineSmall}</p>
      </div>

      <nav class="site-footer-col" aria-labelledby="footer-explore">
        <h2 id="footer-explore" data-i18n-path="hm.footer.explore">{copy.explore}</h2>
        <ul>
          <li>
            <a href="/#how" data-i18n-path="sections.howItWorks">{messages.en.sections.howItWorks}</a>
          </li>
          <li>
            <a href="/areas/" data-i18n-path="sections.areas">{messages.en.sections.areas}</a>
          </li>
          <li>
            <a href="/referral/" data-i18n-path="nav.referralSheet">{messages.en.nav.referralSheet}</a>
          </li>
        </ul>
      </nav>

      <nav class="site-footer-col" aria-labelledby="footer-information">
        <h2 id="footer-information" data-i18n-path="hm.footer.information">{copy.information}</h2>
        <ul>
          <li>
            <a href="/privacy/" data-i18n-path="hm.footer.privacy">{copy.privacy}</a>
          </li>
          <li>
            <a href="/disclaimer/" data-i18n-path="hm.footer.disclaimer">{copy.disclaimer}</a>
          </li>
        </ul>
      </nav>

      <div class="site-footer-col">
        <h2 data-i18n-path="sections.contact">{messages.en.sections.contact}</h2>
        <ul class="site-footer-contact">
          <li>
            <a href={site.phoneHref}>
              <HomeIcon name="phone" size={18} />
              <span>{site.phone}</span>
            </a>
          </li>
          <li>
            <a href={mailto}>
              <HomeIcon name="mail" size={18} />
              <span>{site.publicEmail}</span>
            </a>
          </li>
        </ul>
        <p class="site-footer-languages" data-i18n-path="hm.footer.languages">{copy.languages}</p>
      </div>
    </div>

    <div class="site-footer-bottom">
      <p class="site-footer-copy">
        <span>© {year} {site.registeredBusinessName}. </span>
        <span data-i18n-path="hm.footer.rights">{copy.rights}</span>
      </p>
      <p class="site-footer-abn">{site.abnDisplay}</p>
    </div>
    <p class="site-footer-compliance" data-i18n-path="hm.footer.compliance">{copy.compliance}</p>
  </div>
</footer>

<style>
  .site-footer {
    --ft-bg: #e7ede4;
    --ft-rule: #0c312a;
    --ft-heading: #10342e;
    --ft-tagline: #1f453d;
    --ft-muted: #4e6969;
    --ft-line: #9fafaa;
    --ft-plate: #fbfaf8;
    background: var(--ft-bg);
    border-top: 1px solid var(--ft-rule);
    color: var(--ft-heading);
    font-family: "Source Sans 3", "Source Sans 3 Fallback", "PingFang TC", "PingFang SC", "Noto Sans TC", "Noto Sans SC", "Microsoft JhengHei", "Microsoft YaHei", system-ui, sans-serif;
    font-size: 1rem;
    line-height: 1.45;
    padding: 2.6rem 0 1.65rem;
  }

  .site-footer-home {
    padding-bottom: calc(1.65rem + 3.25rem + env(safe-area-inset-bottom, 0px));
  }

  .site-footer-wrap {
    width: min(72rem, calc(100% - 2.5rem));
    margin-inline: auto;
  }

  .site-footer p {
    max-width: none;
    margin: 0;
  }

  .site-footer h2 {
    margin: 0 0 0.85rem;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.3;
    color: var(--ft-heading);
  }

  .site-footer a {
    color: var(--ft-muted);
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--ft-heading);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .site-footer a:focus-visible {
    outline: 3px solid var(--ft-heading);
    outline-offset: 3px;
  }

  .site-footer-grid {
    display: grid;
    gap: 1.75rem 2.5rem;
  }

  .site-footer-logo {
    display: inline-block;
    width: 11.5rem;
    aspect-ratio: 627 / 287;
    overflow: hidden;
    background: var(--ft-plate);
    line-height: 0;
  }

  .site-footer-logo :global(picture),
  .site-footer-logo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .site-footer-logo :global(img) {
    object-fit: cover;
    object-position: center bottom;
  }

  .site-footer-tagline {
    margin-top: 1rem;
    max-width: 18rem;
    color: var(--ft-tagline);
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .site-footer-tagline-small {
    margin-top: 0.45rem;
    max-width: 17rem;
    color: var(--ft-muted);
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.45;
  }

  .site-footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  .site-footer-col a {
    font-size: 0.9375rem;
  }

  .site-footer-contact a {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.45rem;
  }

  .site-footer-contact :global(svg) {
    flex: none;
    margin-top: 0.12rem;
  }

  .site-footer-contact span {
    overflow-wrap: anywhere;
  }

  .site-footer-languages {
    margin-top: 0.7rem;
    color: var(--ft-muted);
    font-size: 0.9375rem;
  }

  .site-footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem 1.5rem;
    flex-wrap: wrap;
    margin-top: 1.85rem;
    padding-top: 0.95rem;
    border-top: 1px solid var(--ft-line);
    color: var(--ft-muted);
    font-size: 0.8125rem;
  }

  .site-footer-abn {
    margin-left: auto;
  }

  .site-footer-compliance {
    margin-top: 0.55rem;
    color: #3e5854;
    font-size: 0.8125rem;
    line-height: 1.45;
    max-width: 62rem;
  }

  @media (min-width: 36rem) {
    .site-footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .site-footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 60rem) {
    .site-footer-grid {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.85fr) minmax(0, 0.9fr) minmax(0, 1.15fr);
      gap: 2rem 2.25rem;
    }

    .site-footer-brand {
      grid-column: auto;
    }
  }

  @media (min-width: 1024px) {
    .site-footer-home {
      padding-bottom: 1.65rem;
    }
  }
</style>
