---
import { site, getEmailHref } from "../content/site";
import { messages } from "../content/i18n";
import { suburbPages, suburbPath } from "../content/suburbs";

const year = new Date().getFullYear();
const emailHref = getEmailHref();
const nav = messages.en.nav;
const links = [
  { href: "/#services", path: "nav.services", label: nav.services },
  { href: "/#how", path: "nav.howItWorks", label: nav.howItWorks },
  { href: "/#about", path: "nav.about", label: nav.about },
  { href: "/#areas", path: "nav.areas", label: nav.areas },
  { href: "/#ndis", path: "nav.ndis", label: nav.ndis },
  { href: "/#faq", path: "nav.faq", label: nav.faq },
  { href: "/#contact", path: "nav.contact", label: nav.contact },
] as const;
---

<footer class="qb-footer">
  <div class="qb-wrap qb-footer-grid">
    <div>
      <p class="qb-footer-name">{site.businessName}</p>
      <p>
        {site.registeredBusinessName} · {site.soleTraderName}, sole trader
      </p>
      <p>
        <a href={site.phoneHref}>{site.phone}</a>
      </p>
      <p>
        <a href={emailHref}>{site.publicEmail}</a>
      </p>
      <p>{site.abnDisplay}</p>
      <p>AHPRA registered physiotherapist</p>
      <p>{site.ahpraNotice}</p>
    </div>
    <div>
      <p class="qb-footer-name" data-i18n-path="sections.areas">{messages.en.sections.areas}</p>
      <ul class="qb-footer-suburbs">
        {
          suburbPages.map((suburb) => (
            <li>
              <a href={suburbPath(suburb.slug)}>{suburb.name}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="qb-wrap">
    <div class="qb-footer-links">
      {
        links.map((item) => (
          <a href={item.href} data-i18n-path={item.path}>
            {item.label}
          </a>
        ))
      }
      <a href="/privacy/" data-i18n-path="hm.footer.privacy">{site.footer.privacyLinkLabel}</a>
      <a href="/disclaimer/" data-i18n-path="hm.footer.disclaimer">{site.footer.disclaimerLinkLabel}</a>
      <a href="/referral/" data-i18n-path="nav.referralSheet">{messages.en.nav.referralSheet}</a>
    </div>
    <p class="qb-copy">
      © {year} {site.businessName}. <span data-i18n-path="hm.footer.rights">{site.footer.copyrightSuffix}</span>
    </p>
  </div>
</footer>
