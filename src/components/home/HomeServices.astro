---
import { homeServices } from "../../content/home-motion";
import HomeIcon from "./HomeIcon.astro";
---

<section id="services" class="hm-band hm-band-green">
  <div class="hm-wrap hm-section">
    <div class="hm-section-head">
      <div>
        <h2 data-i18n-path="hm.services.heading">{homeServices.heading}</h2>
        <p class="hm-supporting" data-i18n-path="hm.services.supporting">{homeServices.supporting}</p>
      </div>
      <a class="hm-text-link" href="#contact">
        <span data-i18n-path="hm.services.enquire">{homeServices.enquire}</span>
        <span class="hm-arrow" aria-hidden="true">→</span>
      </a>
    </div>
    <p class="sr-only" data-i18n-path="services.intro">{homeServices.intro}</p>
    <ul class="hm-service-grid">
      {
        homeServices.cards.map((card, i) => (
          <li>
            <div class="hm-card hm-service-card">
              <span class="hm-service-photo">
                <img
                  src={card.image.src}
                  alt={card.image.alt}
                  width={card.image.width}
                  height={card.image.height}
                  decoding="async"
                />
              </span>
              <span class="hm-service-icon">
                <HomeIcon name={card.icon} size={34} />
              </span>
              <h3 data-i18n-path={`hm.services.cards.${i}.title`}>{card.title}</h3>
              <p data-i18n-path={`hm.services.cards.${i}.body`}>{card.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
