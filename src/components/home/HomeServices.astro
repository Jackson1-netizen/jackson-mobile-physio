---
import { homeServices } from "../../content/home-motion";

const leaf =
  "M72 8c18 22 18 48 4 72-22 38-62 58-92 48 28-18 42-48 34-82C10 22 38-8 72 8Z";
---

<section id="services" class="hm-band hm-band-green hm-reveal scroll-mt-24">
  <svg class="hm-leaf hm-leaf-bl" viewBox="0 0 120 140" aria-hidden="true">
    <path fill="currentColor" d={leaf}></path>
  </svg>
  <svg class="hm-leaf hm-leaf-tr" viewBox="0 0 120 140" aria-hidden="true">
    <path fill="currentColor" d={leaf}></path>
  </svg>
  <div class="hm-wrap hm-section">
    <div class="hm-section-head">
      <div>
        <p class="hm-kicker">{homeServices.kicker}</p>
        <h2>{homeServices.heading}</h2>
        <p class="mt-3 max-w-xl text-white/90">{homeServices.intro}</p>
      </div>
      <a class="hm-btn hm-btn-ghost" href="#contact">
        {homeServices.viewAll}
        <span class="hm-arrow" aria-hidden="true">→</span>
      </a>
    </div>
    <ul class="hm-service-grid hm-stagger">
      {
        homeServices.cards.map((card) => (
          <li>
            <a class="hm-card" href="#contact">
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
