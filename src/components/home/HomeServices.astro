---
import HomeIcon from "./HomeIcon.astro";
import BandCta from "./BandCta.astro";
import { homeServices } from "../../content/home-motion";
---

<section id="services" class="a-band a-band-cream" aria-labelledby="services-heading">
  <div class="a-wrap">
    <h2 id="services-heading" data-i18n-path="hm.services.heading">{homeServices.heading}</h2>
    <p class="a-lede" data-i18n-path="hm.services.supporting">{homeServices.supporting}</p>
    <p class="a-note" data-i18n-path="services.intro">{homeServices.intro}</p>
    <div class="a-services">
      {
        homeServices.cards.map((card, i) => (
          <article class="a-card">
            <span class="a-card-icon">
              <HomeIcon name={card.icon} size={28} />
            </span>
            <h3 data-i18n-path={`hm.services.cards.${i}.title`}>{card.title}</h3>
            <p data-i18n-path={`hm.services.cards.${i}.body`}>{card.body}</p>
          </article>
        ))
      }
    </div>
    <BandCta />
  </div>
</section>
