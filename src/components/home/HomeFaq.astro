---
import { homeFaq } from "../../content/home-motion";
---

<section id="faq" class="hm-faq hm-reveal scroll-mt-24 bg-[var(--hm-warm-white)]">
  <div class="hm-wrap hm-section hm-faq-layout">
    <div class="lg:sticky lg:top-24 lg:self-start">
      <p class="hm-kicker" data-i18n-path="nav.faq">FAQ</p>
      <h2 data-i18n-path="sections.faq">Useful answers before we talk</h2>
    </div>
    <div>
      {
        homeFaq.map((item, i) => (
          <details>
            <summary>
              <span data-i18n-path={`faq.items.${i}.question`}>{item.question}</span>
              <span class="hm-faq-mark" aria-hidden="true">+</span>
            </summary>
            <p data-i18n-path={`faq.items.${i}.answer`}>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
