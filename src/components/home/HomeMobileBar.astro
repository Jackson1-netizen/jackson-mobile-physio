---
import { site } from "../../content/site";
import { messages } from "../../content/i18n";
import { homeHero } from "../../content/home-motion";
---

<nav
  class="hm-mobile-bar no-print sm:hidden"
  aria-label={messages.en.hm.mobileBar.label}
  data-i18n-attr="aria-label:hm.mobileBar.label"
>
  <a href={site.phoneHref} data-i18n-path="cta.call">Call</a>
  <a href="#contact">
    <span data-i18n-path="home.primaryCta">{homeHero.primaryCta}</span>
  </a>
</nav>
