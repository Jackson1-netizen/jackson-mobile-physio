---
import BandCta from "./BandCta.astro";
import { site } from "../../content/site";
import { messages } from "../../content/i18n";
import { homeReferrers } from "../../content/home-motion";
---

<section id="ndis" class="a-band a-band-cream" aria-labelledby="ndis-heading">
  <div class="a-wrap a-split">
    <div>
      <h2 id="ndis-heading" data-i18n-path="sections.ndis">{messages.en.sections.ndis}</h2>
      <div class="a-stack">
        <p data-i18n-path="ndis.lead">{site.ndisDescription}</p>
        <p>{site.ndisNotRegistered}</p>
        <p>{site.ndisFundingNote}</p>
      </div>
    </div>
    <div>
      <h3 data-i18n-path="hm.referrers.heading">{homeReferrers.heading}</h3>
      <div class="a-stack">
        <p data-i18n-path="hm.referrers.lead">{homeReferrers.lead}</p>
        <ul class="a-points">
          {
            homeReferrers.points.slice(0, 2).map((point, i) => (
              <li data-i18n-path={`hm.referrers.points.${i}`}>{point.title}</li>
            ))
          }
        </ul>
        <p>
          <a class="a-btn a-btn-outline" href="/referral/">
            <span data-i18n-path="hm.referrers.cta">{homeReferrers.cta}</span>
          </a>
        </p>
      </div>
      <BandCta />
    </div>
  </div>
</section>
