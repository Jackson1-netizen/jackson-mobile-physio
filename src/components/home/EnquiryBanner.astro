---
import HomePicture from "./HomePicture.astro";
import { site } from "../../content/site";
import { homeBanner, kitchenBenchPhoto } from "../../content/home-motion";
---

<section class="hm-banner no-print" aria-labelledby="hm-banner-heading">
  <div class="hm-banner-photo">
    <HomePicture
      photo={kitchenBenchPhoto}
      altPath="hm.aboutBlock.photoAlt"
      sizes="(min-width: 768px) 280px, 100vw"
    />
    <p class="hm-banner-caption" data-i18n-path="hm.banner.caption">{homeBanner.caption}</p>
  </div>
  <div class="hm-banner-copy">
    <p class="hm-banner-kicker" data-i18n-path="hm.banner.kicker">{homeBanner.kicker}</p>
    <h2 id="hm-banner-heading" data-i18n-path="hm.banner.heading">{homeBanner.heading}</h2>
    <p data-i18n-path="hm.banner.support">{homeBanner.support}</p>
    <div class="hm-banner-actions">
      <a class="hm-btn hm-btn-primary" href="/enquiry/">
        <span data-i18n-path="hm.banner.enquire">{homeBanner.enquire}</span>
        <span class="hm-arrow" aria-hidden="true">→</span>
      </a>
      <a class="hm-btn hm-banner-call" href={site.phoneHref}>
        <span data-i18n-path="hm.banner.call">{homeBanner.call}</span>
      </a>
    </div>
    <p class="hm-banner-note" data-i18n-path="hm.banner.note">{homeBanner.note}</p>
  </div>
</section>

<style is:global>
  .hm-banner {
    display: grid;
    grid-template-columns: 1fr;
    background: linear-gradient(105deg, #0c3f3a 0%, #14685e 48%, #1a7a68 100%);
    color: #fff;
  }

  .hm-banner-photo {
    position: relative;
    height: 9.5rem;
    overflow: hidden;
    background: #0c3f3a;
  }

  .hm-banner-photo picture {
    display: contents;
  }

  .hm-banner-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 42% 28%;
  }

  .hm-banner-caption {
    position: absolute;
    z-index: 1;
    right: 0.625rem;
    bottom: 0.625rem;
    margin: 0;
    padding: 0.125rem 0.375rem;
    border-radius: 0.2rem;
    background: rgb(8 32 30 / 0.62);
    color: #faf6f0;
    font-size: 0.6875rem;
    font-weight: 400;
    line-height: 1.3;
  }

  .hm-banner-copy {
    padding: 1rem 1.15rem 1.1rem;
  }

  .hm-banner-kicker {
    margin: 0;
    color: #ffd2b8;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hm-banner h2 {
    margin: 0.3rem 0 0;
    max-width: 36rem;
    color: #fff;
    font-family: "Source Serif 4", "Source Serif 4 Fallback", Georgia, serif;
    font-size: clamp(1.28rem, 1rem + 1vw, 1.7rem);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .hm-banner-copy > p {
    margin: 0.4rem 0 0;
    max-width: 40rem;
    color: rgb(255 253 249 / 0.92);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .hm-banner-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .hm-banner .hm-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 2.5rem;
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.92rem;
    line-height: 1.2;
    text-decoration: none;
  }

  .hm-banner .hm-btn-primary {
    background: #c4461a;
    color: #fff;
    border: 2px solid #c4461a;
  }

  .hm-banner .hm-btn-primary:hover {
    background: #a9380b;
    border-color: #a9380b;
    color: #fff;
  }

  .hm-banner-call {
    background: #fff;
    color: #16352e;
    border: 2px solid #fff;
  }

  .hm-banner-call:hover {
    background: #fff4ec;
    border-color: #fff4ec;
    color: #16352e;
  }

  .hm-banner-note {
    margin-top: 0.45rem;
    font-size: 0.78rem;
    color: rgb(255 253 249 / 0.84);
  }

  @media (min-width: 768px) {
    .hm-banner {
      grid-template-columns: minmax(11rem, 24%) minmax(0, 1fr);
      min-height: 220px;
      max-height: 250px;
    }

    .hm-banner-photo {
      height: auto;
      min-height: 220px;
    }

    .hm-banner-copy {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 0.85rem 1.5rem 0.9rem 1.35rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hm-banner .hm-btn {
      transition: none;
    }
  }
</style>
