---
import { site, getEmailHref } from "../../content/site";
import { messages } from "../../content/i18n";
import EnquiryForm from "../EnquiryForm.astro";

const publicMailto = getEmailHref();
---

<section id="contact" class="a-band a-band-cream a-contact" aria-labelledby="contact-heading">
  <div class="a-wrap">
    <h2 id="contact-heading" data-i18n-path="sections.contact">{messages.en.sections.contact}</h2>
    <p class="a-lede" data-i18n-path="enquiry.intro">{messages.en.enquiry.intro}</p>
    <div class="a-contact-list">
      <a href={site.phoneHref} translate="no">{site.phone}</a>
      <a href={publicMailto}>{site.publicEmail}</a>
    </div>
    <EnquiryForm />
  </div>
</section>
