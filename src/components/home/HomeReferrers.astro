---
import { homeReferrers } from "../../content/home-motion";
import { site, getReferralEmailHref } from "../../content/site";
import HomeIcon from "./HomeIcon.astro";

const referralMailto = getReferralEmailHref();
const [referralLocal, referralDomain] = site.referralEmail.split("@");
const t = homeReferrers;
---

<section id="referrers" class="hm-band hm-band-refer hm-refpanel" aria-labelledby="hm-refer-heading">
  <div class="hm-ref-bg" aria-hidden="true">
    <svg class="hm-ref-arc hm-ref-arc-tr" viewBox="0 0 280 220">
      <path d="M20 200C90 40 180 20 270 90" fill="none" stroke="#e7a06a" stroke-width="1.4"></path>
    </svg>
    <svg class="hm-ref-arc hm-ref-arc-br" viewBox="0 0 220 180">
      <path d="M10 20c70 30 120 90 200 140" fill="none" stroke="#e7a06a" stroke-width="1.2"></path>
    </svg>
  </div>
  <div class="hm-wrap hm-section hm-refer-grid">
    <div class="hm-ref-copy">
      <p class="hm-ref-kicker">
        <span data-i18n-path="hm.referrers.kicker">{t.kicker}</span>
        <span class="hm-ref-kicker-rule" aria-hidden="true"></span>
      </p>
      <h2 id="hm-refer-heading" data-i18n-path="hm.referrers.heading">{t.heading}</h2>
      <p class="hm-ref-lead" data-i18n-path="hm.referrers.lead">{t.lead}</p>
      <ol class="hm-ref-steps">
        {
          t.steps.map((step, i) => (
            <li>
              <span class="hm-ref-step-icon" aria-hidden="true">
                <HomeIcon name={step.icon} size={22} />
                <span class="hm-ref-step-num">{i + 1}</span>
              </span>
              <strong data-i18n-path={`hm.referrers.steps.${i}.title`}>{step.title}</strong>
              <span data-i18n-path={`hm.referrers.steps.${i}.body`}>{step.body}</span>
            </li>
          ))
        }
      </ol>
      <ul class="hm-ref-cards">
        <li class="hm-ref-card hm-ref-card-ahpra">
          <span class="hm-ref-badge" aria-hidden="true"><HomeIcon name="shield" size={30} /></span>
          <p>
            <span class="hm-ref-ahpra-lead" data-i18n-path="hm.referrers.ahpraLead">{t.ahpraLead}</span>
            <span class="hm-ref-ahpra-rest" data-i18n-path="hm.referrers.ahpraRest">{t.ahpraRest}</span>
          </p>
        </li>
        <li class="hm-ref-card">
          <span class="hm-ref-badge hm-ref-badge-hands" aria-hidden="true"><HomeIcon name="handshake" size={30} /></span>
          <p class="hm-ref-card-title" data-i18n-path="hm.referrers.ndisCard">{t.ndisCard}</p>
          <p class="hm-ref-card-note" data-i18n-path="hm.referrers.ndisLimit">{t.ndisLimit}</p>
        </li>
        <li class="hm-ref-card hm-ref-card-mail">
          <span class="hm-ref-badge hm-ref-badge-mail" aria-hidden="true"><HomeIcon name="mail" size={28} /></span>
          <a class="hm-ref-email" href={referralMailto}>
            <span>{referralLocal}@</span>
            <span>{referralDomain}</span>
          </a>
          <a class="hm-ref-btn" href="/referral/">
            <span data-i18n-path="hm.referrers.cta">{t.cta}</span>
            <span class="hm-ref-btn-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      </ul>
    </div>
    <svg class="hm-ref-clipdefs" width="0" height="0" aria-hidden="true">
      <defs>
        <clipPath id="hm-ref-blob" clipPathUnits="objectBoundingBox">
          <path d="M0.04,0.1 L0.04,0.72 C0.06,0.9 0.28,0.99 0.55,0.98 C0.78,0.97 0.94,0.86 0.99,0.68 C0.99,0.42 0.96,0.18 0.78,0.08 C0.58,0.01 0.28,0.04 0.04,0.1 Z"></path>
        </clipPath>
      </defs>
    </svg>
    <div class="hm-ref-visual">
      <div class="hm-ref-shape">
        <div class="hm-ref-photo" data-asset="missing"></div>
        <div class="hm-ref-shade" aria-hidden="true"></div>
      </div>
      <div class="hm-ref-quote">
        <span class="hm-ref-quote-rule" aria-hidden="true"></span>
        <p class="hm-ref-quote-title">
          <span data-i18n-path="hm.referrers.quoteBefore">{t.quoteBefore}</span><em data-i18n-path="hm.referrers.quoteWord">{t.quoteWord}</em><span data-i18n-path="hm.referrers.quoteAfter">{t.quoteAfter}</span>
        </p>
        <p class="hm-ref-quote-body" data-i18n-path="hm.referrers.quoteBody">{t.quoteBody}</p>
        <span class="hm-ref-quote-rule" aria-hidden="true"></span>
        <p class="hm-ref-tag" data-i18n-path="hm.referrers.tagline">{t.tagline}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hm-refpanel {
    position: relative;
    isolation: isolate;
    overflow: clip;
    color: #f7f3ee;
    background:
      radial-gradient(ellipse 42% 55% at 100% 0%, #1d4c40 0%, transparent 62%),
      radial-gradient(ellipse 36% 48% at 0% 100%, #0c2822 0%, transparent 70%),
      #12352c;
  }

  .hm-refpanel::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.045) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: radial-gradient(ellipse at 30% 40%, #000 20%, transparent 75%);
  }

  .hm-ref-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hm-ref-clipdefs {
    position: absolute;
  }

  .hm-ref-arc {
    position: absolute;
  }

  .hm-ref-arc-tr {
    top: -1rem;
    right: -2rem;
    width: min(18rem, 28vw);
  }

  .hm-ref-arc-br {
    right: 6%;
    bottom: -1rem;
    width: min(14rem, 22vw);
  }

  .hm-refpanel .hm-refer-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.95fr);
    gap: 1.5rem 2rem;
    align-items: stretch;
    width: min(76rem, calc(100% - 3rem));
    padding-block: clamp(2.2rem, 4vw, 3.2rem);
  }

  .hm-ref-copy {
    min-width: 0;
  }

  .hm-ref-kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    color: #f4efe8;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.18em;
    line-height: 1;
    text-transform: uppercase;
  }

  .hm-ref-kicker-rule {
    width: 2.4rem;
    height: 2px;
    background: #e28a4a;
  }

  .hm-refpanel h2 {
    margin: 0.7rem 0 0;
    max-width: 12ch;
    color: #fff;
    font-family: var(--hm-serif);
    font-size: clamp(2.7rem, 4.6vw, 4.15rem);
    font-weight: 560;
    letter-spacing: -0.03em;
    line-height: 0.98;
  }

  .hm-ref-lead {
    max-width: 54ch;
    margin: 0.9rem 0 0;
    color: rgb(244 239 232 / 0.9);
    font-size: 1.02rem;
    line-height: 1.45;
  }

  .hm-ref-steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
    margin: 1.35rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hm-ref-steps::before {
    content: "";
    position: absolute;
    top: 1.35rem;
    left: 12%;
    right: 12%;
    height: 1px;
    background: rgb(255 255 255 / 0.28);
  }

  .hm-ref-steps li {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    text-align: center;
  }

  .hm-ref-step-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 3.15rem;
    height: 3.15rem;
    border-radius: 999px;
    background: #f6efe6;
    color: #e07a3d;
  }

  .hm-ref-step-num {
    position: absolute;
    top: -0.15rem;
    right: -0.15rem;
    display: grid;
    place-items: center;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 999px;
    background: #e07a3d;
    color: #fff;
    font-size: 0.68rem;
    font-weight: 800;
  }

  .hm-ref-steps strong {
    color: #fff;
    font-size: 0.92rem;
    font-weight: 750;
    line-height: 1.25;
  }

  .hm-ref-steps li > span:last-child {
    color: rgb(244 239 232 / 0.82);
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .hm-ref-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.7rem;
    margin: 1.6rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hm-ref-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
    min-width: 0;
    min-height: 13.5rem;
    height: 100%;
    padding: 1rem 0.9rem 0.95rem;
    border-radius: 1.05rem;
    background: #f7f1e8;
    color: #16352e;
  }

  .hm-ref-badge {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.6rem;
    height: 3.6rem;
    border-radius: 999px;
    background: #d7efe8;
    color: #14685e;
  }

  .hm-ref-badge-hands {
    background: #e5efe8;
    color: #16352e;
  }

  .hm-ref-badge-mail {
    background: #f6d7c8;
    color: #c4531d;
  }

  .hm-ref-ahpra-lead {
    display: block;
    color: #14685e;
    font-size: 1.2rem;
    font-weight: 650;
    line-height: 1.15;
  }

  .hm-ref-ahpra-rest {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.95rem;
    font-weight: 650;
  }

  .hm-ref-card-ahpra {
    background: #e7f3ea;
  }

  .hm-ref-card p {
    max-width: none;
    margin: 0;
    color: #16352e;
    font-size: 0.95rem;
    font-weight: 750;
    line-height: 1.3;
  }

  .hm-ref-card-note {
    color: #3d534c !important;
    font-size: 0.84rem !important;
    font-weight: 450 !important;
  }

  .hm-ref-email {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 100%;
    min-width: 0;
    color: #16352e;
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.3;
    text-decoration: none;
  }

  .hm-ref-email span {
    display: block;
    max-width: 100%;
    white-space: nowrap;
  }

  .hm-ref-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    width: fit-content;
    max-width: 100%;
    min-height: 2.75rem;
    margin-top: auto;
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    background: #c4531d;
    color: #fff;
    font-size: 0.92rem;
    font-weight: 750;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
  }

  .hm-ref-card .hm-ref-btn,
  .hm-ref-card .hm-ref-btn:hover {
    color: #fff;
  }

  .hm-ref-btn:hover {
    background: #a9380b;
  }

  .hm-ref-btn:focus-visible,
  .hm-ref-card a:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  .hm-ref-visual {
    position: relative;
    min-height: 28rem;
  }

  .hm-ref-shape,
  .hm-ref-photo,
  .hm-ref-shade {
    position: absolute;
    inset: 0;
  }

  .hm-ref-shape {
    clip-path: url("#hm-ref-blob");
    background: #0e2c26;
  }

  .hm-ref-photo[data-asset="missing"] {
    background:
      radial-gradient(ellipse 50% 60% at 72% 48%, #245246 0%, transparent 70%),
      #0e2c26;
  }

  .hm-ref-shade {
    background: linear-gradient(90deg, rgb(10 36 30 / 0.94) 0%, rgb(10 36 30 / 0.78) 36%, rgb(10 36 30 / 0.28) 62%, rgb(10 36 30 / 0.05) 100%);
  }

  .hm-ref-quote {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0.65rem;
    min-height: 100%;
    padding: 1.6rem 22% 1.2rem 0.2rem;
  }

  .hm-ref-quote-rule {
    display: block;
    width: 2.2rem;
    height: 2px;
    background: #e28a4a;
  }

  .hm-ref-quote-title {
    max-width: 14ch;
    margin: 0;
    color: #fff;
    font-family: var(--hm-serif);
    font-size: clamp(1.85rem, 2.1vw, 2.45rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .hm-ref-quote-title em {
    color: #e28a4a;
    font-style: italic;
  }

  .hm-ref-quote-body {
    max-width: 28ch;
    margin: 0;
    color: rgb(244 239 232 / 0.88);
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .hm-ref-tag {
    max-width: 9ch;
    margin: 0;
    color: #d7e4de;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  :lang(zh) .hm-ref-kicker,
  :lang(zh-Hant) .hm-ref-kicker,
  :lang(zh-Hans) .hm-ref-kicker,
  :lang(zh) .hm-ref-tag,
  :lang(zh-Hant) .hm-ref-tag,
  :lang(zh-Hans) .hm-ref-tag {
    letter-spacing: 0.04em;
    text-transform: none;
  }

  @media (max-width: 1099px) {
    .hm-refpanel .hm-refer-grid {
      grid-template-columns: 1fr;
      width: min(46rem, calc(100% - 2rem));
    }

    .hm-ref-visual {
      min-height: 22rem;
    }
  }

  @media (max-width: 720px) {
    .hm-ref-steps,
    .hm-ref-cards {
      grid-template-columns: 1fr;
    }

    .hm-ref-steps::before {
      display: none;
    }

    .hm-ref-steps li {
      justify-items: start;
      grid-template-columns: auto 1fr;
      column-gap: 0.75rem;
      text-align: left;
    }

    .hm-ref-steps strong,
    .hm-ref-steps li > span:last-child {
      grid-column: 2;
    }

    .hm-ref-step-icon {
      grid-row: 1 / span 2;
    }

    .hm-refpanel h2 {
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hm-ref-btn {
      transition: none;
    }
  }
</style>
