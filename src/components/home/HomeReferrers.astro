---
import { homeReferrers } from "../../content/home-motion";
import HomeIcon from "./HomeIcon.astro";

const leaf = "M72 8c18 22 18 48 4 72-22 38-62 58-92 48 28-18 42-48 34-82C10 22 38-8 72 8Z";
---

<section id="referrers" class="hm-band hm-band-refer">
  <svg class="hm-leaf hm-leaf-tr" viewBox="0 0 120 140" aria-hidden="true">
    <path fill="currentColor" d={leaf}></path>
  </svg>
  <div class="hm-wrap hm-section hm-refer-grid">
    <div class="hm-refer-copy">
      <h2 data-i18n-path="hm.referrers.heading">{homeReferrers.heading}</h2>
      <p class="mt-4" data-i18n-path="hm.referrers.lead">{homeReferrers.lead}</p>
      <p class="hm-registered" data-i18n-path="hm.referrers.registration">{homeReferrers.registration}</p>
      <a class="hm-btn hm-btn-outline" href="/referral">
        <span data-i18n-path="hm.referrers.cta">{homeReferrers.cta}</span>
        <span class="hm-arrow" aria-hidden="true">→</span>
      </a>
    </div>
    <ul class="hm-refer-points">
      {
        homeReferrers.points.map((point, i) => (
          <li>
            <span class="hm-refer-icon">
              <HomeIcon name={point.icon} size={36} />
            </span>
            <p data-i18n-path={`hm.referrers.points.${i}`}>{point.title}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
