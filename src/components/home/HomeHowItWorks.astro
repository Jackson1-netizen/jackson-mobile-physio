---
import BandCta from "./BandCta.astro";
import { site } from "../../content/site";
import { messages } from "../../content/i18n";
import { homeSteps } from "../../content/home-motion";

const shotLabel = "Photo to be shot: Jackson arriving at a front door with his kit";
---

<section id="visit" class="a-band a-band-forest" aria-labelledby="visit-heading">
  <div class="a-wrap a-visit-grid">
    <div>
      <p class="a-eyebrow">Your first visit</p>
      <h2 id="visit-heading" data-i18n-path="hm.how.heading">{messages.en.hm.how.heading}</h2>
      <p class="a-visit-who" translate="no">{site.practitionerName}</p>
      <p data-i18n-path="about.role">{messages.en.about.role}</p>
      <ol class="a-steps">
        {
          homeSteps.map((step, i) => (
            <li>
              <span class="a-step-num">{step.num}</span>
              <div>
                <h3 data-i18n-path={`hm.how.steps.${i}.title`}>{step.title}</h3>
                <p data-i18n-path={`hm.how.steps.${i}.body`}>{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <BandCta />
    </div>
    <figure class="a-shot">
      <div class="a-door-scene" aria-hidden="true">
        <span class="a-door"></span>
      </div>
      <figcaption class="a-caption">{shotLabel}</figcaption>
    </figure>
  </div>
</section>
