---
import HomePicture from "./HomePicture.astro";
import { homeSteps, homeMedia } from "../../content/home-motion";
import { messages } from "../../content/i18n";

const photo = homeMedia.how;
---

<section id="how" class="hm-how hm-reveal">
  <div class="hm-wrap hm-section hm-how-grid">
    <div>
      <p class="hm-kicker" data-i18n-path="hm.how.kicker">{messages.en.hm.how.kicker}</p>
      <h2 data-i18n-path="hm.how.heading">{messages.en.hm.how.heading}</h2>
      <ol class="hm-step-grid mt-8">
        {
          homeSteps.map((step, i) => (
            <li class="hm-card hm-step">
              <span class="hm-step-num">{step.num}</span>
              <h3 data-i18n-path={`hm.how.steps.${i}.title`}>{step.title}</h3>
              <p data-i18n-path={`hm.how.steps.${i}.body`}>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="hm-how-media hm-img-zoom">
      <HomePicture
        photo={photo}
        altPath="hm.photos.sitToStandAlt"
        sizes="(min-width: 1024px) 556px, (min-width: 768px) 728px, calc(100vw - 2.5rem)"
      />
    </div>
  </div>
</section>
