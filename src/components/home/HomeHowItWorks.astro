---
import { homeSteps } from "../../content/home-motion";
import { messages } from "../../content/i18n";

const copy = messages.en.hm.how;
const widths = [800, 1200, 1600, 2400] as const;
const srcset = (ext: string) => widths.map((w) => `/photos/hero/portrait-${w}.${ext} ${w}w`).join(", ");
---

<section id="how" class="hm-how hm-flow hm-reveal" aria-labelledby="hm-how-heading">
  <div class="hm-wrap hm-section hm-flow-grid">
    <div class="hm-flow-copy">
      <p class="hm-flow-kicker" data-i18n-path="hm.how.kicker">{copy.kicker}</p>
      <h2 id="hm-how-heading" data-i18n-path="hm.how.heading">{copy.heading}</h2>
      <ol class="hm-flow-steps">
        {
          homeSteps.map((step, i) => (
            <li>
              <span class="hm-flow-num" aria-hidden="true">{step.num}</span>
              <span class="hm-flow-rule" aria-hidden="true"></span>
              <span>
                <h3 data-i18n-path={`hm.how.steps.${i}.title`}>{step.title}</h3>
                <p data-i18n-path={`hm.how.steps.${i}.body`}>{step.body}</p>
              </span>
            </li>
          ))
        }
      </ol>
    </div>
    <figure class="hm-flow-media">
      <div class="hm-flow-frame">
        <picture>
          <source type="image/avif" srcset={srcset("avif")} sizes="(min-width: 960px) 34rem, calc(100vw - 2.5rem)" />
          <source type="image/webp" srcset={srcset("webp")} sizes="(min-width: 960px) 34rem, calc(100vw - 2.5rem)" />
          <img
            src="/photos/hero/portrait-1200.jpg"
            srcset={srcset("jpg")}
            sizes="(min-width: 960px) 34rem, calc(100vw - 2.5rem)"
            alt={copy.photoAlt}
            data-i18n-attr="alt:hm.how.photoAlt"
            width="2400"
            height="3000"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </div>
      <figcaption data-i18n-path="hm.how.caption">{copy.caption}</figcaption>
    </figure>
    <p class="hm-flow-note" data-i18n-path="hm.how.note">{copy.note}</p>
  </div>
</section>

<style is:global>
  .hm-how.hm-flow {
    background: #e6f1ea;
    color: #16352e;
  }

  .hm-flow-grid {
    display: grid;
    gap: 1.25rem;
    align-items: stretch;
  }

  .hm-flow-kicker {
    margin: 0;
    color: #b8410f;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hm-flow h2 {
    margin: 0.45rem 0 0;
    max-width: 9.2em;
    color: #16352e;
    font-family: var(--hm-sans);
    font-size: var(--hm-section-title, clamp(2.15rem, 1.2rem + 2.1vw, 3.05rem));
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.08;
    text-wrap: balance;
  }

  .hm-flow-steps {
    display: grid;
    gap: 0.75rem;
    margin: 1.15rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hm-flow-steps li {
    display: grid;
    grid-template-columns: 3.25rem 1px minmax(0, 1fr);
    gap: 0.85rem;
    align-items: center;
    padding: 0.85rem 0.95rem;
    border-radius: 1.15rem;
    background: #fffdf9;
  }

  .hm-flow-num {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 999px;
    background: #c4461a;
    color: #fff;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .hm-flow-rule {
    width: 1px;
    align-self: stretch;
    background: #e4ddd0;
  }

  .hm-flow-steps h3 {
    margin: 0;
    color: #16352e;
    font-family: "Source Sans 3", "Source Sans 3 Fallback", system-ui, sans-serif;
    font-size: 1.05rem;
    font-weight: 750;
    letter-spacing: 0;
    line-height: 1.3;
  }

  .hm-flow-steps p {
    margin: 0.2rem 0 0;
    color: #3d534c;
    font-size: 0.98rem;
    line-height: 1.45;
  }

  .hm-flow-note {
    grid-column: 1 / -1;
    margin: 0.35rem 0 0;
    max-width: 70rem;
    color: #243f38;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .hm-flow-media {
    position: relative;
    margin: 0;
  }

  .hm-flow-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 1.4rem;
    background: #d5e4d8;
  }

  .hm-flow-frame picture,
  .hm-flow-frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hm-flow-frame img {
    object-fit: cover;
    object-position: 50% 18%;
  }

  .hm-flow-media figcaption {
    position: absolute;
    top: 0.625rem;
    right: 0.625rem;
    margin: 0;
    padding: 0.125rem 0.375rem;
    border-radius: 0.2rem;
    background: transparent;
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 400;
    line-height: 1.3;
  }

  @media (min-width: 960px) {
    .hm-flow-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 1.75rem;
    }

    .hm-flow-media {
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .hm-flow-frame {
      flex: 1;
      min-height: 28rem;
      aspect-ratio: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hm-flow,
    .hm-flow * {
      transition: none;
    }
  }

  @media screen and (max-width: 959px) {
    .hm-flow-grid { gap: var(--hm-content-gap); }
    .hm-flow-frame { aspect-ratio: 4 / 3; border-radius: var(--hm-image-radius); }
    .hm-flow-steps { gap: var(--hm-card-gap); }
    .hm-flow-steps li {
      grid-template-columns: 2.25rem minmax(0, 1fr);
      gap: 0.65rem 0.75rem;
      padding: var(--hm-card-padding);
      border-radius: var(--hm-image-radius);
    }
    .hm-flow-num { grid-column: 1; grid-row: 1; width: 2.25rem; height: 2.25rem; }
    .hm-flow-rule { display: none; }
    .hm-flow-steps li > span:last-child { display: contents; }
    .hm-flow-steps h3 { grid-column: 2; grid-row: 1; align-self: center; }
    .hm-flow-steps p { grid-column: 1 / -1; margin: 0; font-size: 1rem; line-height: 1.5; }
  }
</style>
