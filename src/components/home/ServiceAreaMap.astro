---
import { messages } from "../../content/i18n";
const t = messages.en.hm.areas;
const mapCopy = Object.fromEntries(Object.entries(messages).map(([locale, bundle]) => [locale, {
  loading: bundle.hm.areas.mapLoading,
  unavailable: bundle.hm.areas.mapUnavailable,
  showArea: bundle.hm.areas.showArea,
  selected: bundle.hm.areas.selectedArea,
  visitNote: bundle.hm.areas.visitNote,
  zoomIn: bundle.hm.areas.zoomIn,
  zoomOut: bundle.hm.areas.zoomOut,
  areaDetails: bundle.hm.areas.areaDetails,
  enquireArea: bundle.hm.areas.enquireArea,
  clusterLabel: bundle.hm.areas.clusterLabel,
}]));
---

<div class="hm-area-map" data-hm-map data-map-state="idle">
  <div
    id="hm-service-area-map"
    class="hm-area-map-canvas"
    data-hm-map-canvas
    role="region"
    aria-label={t.mapLabel}
    data-i18n-attr="aria-label:hm.areas.mapLabel"
    aria-describedby="hm-area-map-note"
  ></div>
  <a
    class="hm-area-map-external"
    data-hm-google-map
    href="https://www.google.com/maps/search/?api=1&query=Box%20Hill%20VIC%20Australia"
    target="_blank"
    rel="noopener noreferrer"
    aria-label={t.openMapLabel}
    data-i18n-attr="aria-label:hm.areas.openMapLabel"
  >
    <span data-i18n-path="hm.areas.openMap">{t.openMap}</span><span aria-hidden="true">↗</span>
  </a>
  <button class="hm-area-map-reset" type="button" data-hm-map-reset disabled aria-label={t.fitAreas} data-i18n-attr="aria-label:hm.areas.fitAreas">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <path d="M8 3H3v5M16 3h5v5M21 16v5h-5M8 21H3v-5" /><circle cx="12" cy="12" r="3" />
    </svg>
    <span data-i18n-path="hm.areas.fitAreas">{t.fitAreas}</span>
  </button>
  <div class="hm-area-map-fallback" data-hm-map-fallback>
    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
      <path d="m3 5 6-2 6 2 6-2v16l-6 2-6-2-6 2V5Zm6-2v16m6-14v16" />
    </svg>
    <p data-hm-map-status role="status" data-i18n-path="hm.areas.mapLoading">{t.mapLoading}</p>
    <button class="hm-area-map-retry" type="button" data-hm-map-retry hidden data-i18n-path="hm.areas.retryMap">{t.retryMap}</button>
    <noscript><p data-i18n-path="hm.areas.mapUnavailable">{t.mapUnavailable}</p></noscript>
  </div>
  <p class="sr-only" data-hm-area-status role="status" aria-atomic="true"></p>
  <script type="application/json" data-hm-map-copy set:html={JSON.stringify(mapCopy).replace(/</g, "\\u003c")} />
</div>

<script>
  import { initServiceAreas } from "../../lib/service-area-map";
  initServiceAreas();
</script>
