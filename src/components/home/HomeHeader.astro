---
import HomeLogo from "./HomeLogo.astro";
import { site } from "../../content/site";
import { messages } from "../../content/i18n";
import { homeNav, homeHero } from "../../content/home-motion";
import LanguageSwitcher from "../LanguageSwitcher.astro";

const t = messages.en.hm.header;
---

<header class="hm-header no-print">
  <div class="hm-wrap hm-header-inner">
    <a class="hm-logo" href="/">
      <HomeLogo alt={`${site.displayBrand} ${site.tagline}`} sizes="(min-width: 1024px) 185px, 145px" />
    </a>

    <nav class="hm-nav" aria-label={t.primaryNav} data-i18n-attr="aria-label:hm.header.primaryNav">
      {
        homeNav.map((item) => (
          <a
            href={item.href}
            class={item.spy === "top" ? "is-active" : undefined}
            aria-current={item.spy === "top" ? "page" : undefined}
            data-i18n-path={item.path}
            data-spy={item.spy}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hm-header-tools">
      <div class="hm-lang">
        <LanguageSwitcher />
      </div>
      <a class="hm-btn hm-btn-primary hm-cta-desktop" href="#contact">
        <span data-i18n-path="home.primaryCta">{homeHero.primaryCta}</span>
        <span class="hm-arrow" aria-hidden="true">→</span>
      </a>
      <details class="hm-menu">
        <summary data-i18n-path="hm.header.menu">{t.menu}</summary>
        <div class="hm-menu-panel">
          <nav aria-label={t.mobileNav} data-i18n-attr="aria-label:hm.header.mobileNav">
            {
              homeNav.map((item) => (
                <a href={item.href} data-i18n-path={item.path} data-spy={item.spy}>
                  {item.label}
                </a>
              ))
            }
            <a class="hm-menu-cta" href="#contact" data-i18n-path="home.primaryCta">{homeHero.primaryCta}</a>
          </nav>
          <div class="hm-menu-lang">
            <LanguageSwitcher />
          </div>
        </div>
      </details>
    </div>
  </div>
</header>
