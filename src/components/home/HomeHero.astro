---
import HomePicture from "./HomePicture.astro";
import LanguageSwitcher from "../LanguageSwitcher.astro";
import { site } from "../../content/site";
import { messages } from "../../content/i18n";
import { homeMedia } from "../../content/home-motion";
import { concept1TrustHighlights } from "../../content/concept1-home";

const hero = homeMedia.hero;
const languageLine = concept1TrustHighlights[4].line;
const caption = "Preview placeholder — to be replaced with genuine photography";
const alt = "Preview placeholder photograph of a person with a walking frame indoors. Not a documented visit.";
const eyebrow = messages.en.hm.why.items[3].body;
---

<section id="top" class="a-band a-band-cream a-hero" aria-labelledby="hero-heading">
  <div class="a-wrap a-hero-grid">
    <div class="a-hero-copy">
      <p class="a-eyebrow" data-i18n-path="hm.why.items.3.body">{eyebrow}</p>
      <h1 id="hero-heading">
        <span data-i18n-path="home.h1Lead">{messages.en.home.h1Lead}</span>{" "}
        <span data-i18n-path="home.h1Mid">{messages.en.home.h1Mid}</span>{" "}
        <span data-i18n-path="home.h1Em">{messages.en.home.h1Em}</span>
      </h1>
      <p class="a-byline">
        <span class="a-byline-name" translate="no">{site.practitionerName}</span>
        <span data-i18n-path="about.role">{messages.en.about.role}</span>
      </p>
      <div class="a-actions">
        <a class="a-btn a-btn-primary" href="/#contact">
          <span data-i18n-path="home.primaryCta">{messages.en.home.primaryCta}</span>
        </a>
        <a class="a-btn a-btn-outline" href={site.phoneHref}>
          <span data-i18n-path="cta.call">{messages.en.cta.call}</span>
        </a>
        <a class="a-phone-link" href={site.phoneHref} translate="no">{site.phone}</a>
      </div>
      <p class="a-langs">{languageLine}</p>
      <div class="a-hero-switch">
        <LanguageSwitcher />
      </div>
    </div>
    <figure class="a-figure">
      <div class="a-frame">
        <HomePicture
          photo={{ ...hero, alt }}
          sizes="(min-width: 1180px) 460px, calc(100vw - 2rem)"
          priority
        />
      </div>
      <figcaption class="a-caption">{caption}</figcaption>
    </figure>
    <p class="a-support" data-i18n-path="home.support">{messages.en.home.support}</p>
  </div>
</section>
