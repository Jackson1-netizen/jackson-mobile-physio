---
import { getRegistrationDisplayLine } from "../../content/site";
import { homeHero, homeMedia } from "../../content/home-motion";
import HomeIcon from "./HomeIcon.astro";

const registrationLine = getRegistrationDisplayLine();
---

<section class="hm-hero" aria-labelledby="hm-hero-heading">
  <div class="hm-wrap hm-hero-grid">
    <div>
      <p class="hm-kicker hm-kicker-forest" data-i18n-path="home.eyebrow">{homeHero.eyebrow}</p>
      <h1 id="hm-hero-heading" class="hm-h1-enter">
        <span data-i18n-path="home.h1Lead">{homeHero.h1Lead}</span>
        <br />
        <span data-i18n-path="home.h1Mid">{homeHero.h1Mid}</span>
        <br />
        <span class="hm-em" data-i18n-path="home.h1Em">{homeHero.h1Em}</span>
      </h1>
      <p class="hm-hero-support">{homeHero.support}</p>
      <ul class="hm-chips">
        {
          homeHero.chips.map((chip) => (
            <li>
              <span class="hm-chip-icon">
                <HomeIcon name={chip.icon} size={22} />
              </span>
              <span>{chip.line}</span>
            </li>
          ))
        }
      </ul>
      <div class="hm-hero-actions">
        <a class="hm-btn hm-btn-primary" href="#contact">
          <span data-i18n-path="home.primaryCta">{homeHero.primaryCta}</span>
          <span class="hm-arrow" aria-hidden="true">→</span>
        </a>
        <a class="hm-btn hm-btn-secondary" href="#services">{homeHero.secondaryCta}</a>
      </div>
      <p class="hm-ahpra">{registrationLine}</p>
    </div>

    <div class="hm-hero-frame">
      <div class="hm-hero-media" data-hm-parallax>
        <video
          class="hm-hero-video"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={homeMedia.heroVideo.poster}
          aria-hidden="true"
        >
          <source src={homeMedia.heroVideo.mp4} type="video/mp4" />
        </video>
        <img
          class="hm-hero-poster"
          src={homeMedia.heroVideo.poster}
          alt={homeMedia.heroVideo.alt}
          width="1200"
          height="900"
          fetchpriority="high"
        />
        <img
          class="hm-polo-logo"
          src="/home-motion-logo.png"
          alt=""
          width="627"
          height="388"
        />
      </div>
      <div class="hm-blobs" aria-hidden="true">
        <span class="hm-blob hm-blob-orange"></span>
        <span class="hm-blob hm-blob-green"></span>
        <span class="hm-blob hm-blob-leaf"></span>
      </div>
    </div>
  </div>
  <script>
    const video = document.querySelector<HTMLVideoElement>(".hm-hero-video");
    const logo = document.querySelector(".hm-polo-logo");
    if (video && logo) {
      const sync = () => {
        logo.classList.toggle("is-on-clip", !video.paused && !video.ended && video.readyState >= 2);
      };
      video.addEventListener("playing", sync);
      video.addEventListener("pause", sync);
      video.addEventListener("ended", sync);
    }
  </script>
</section>
