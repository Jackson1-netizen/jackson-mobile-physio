---
import HomePicture from "./HomePicture.astro";
import HomeIcon from "./HomeIcon.astro";
import { site } from "../../content/site";
import { homeAbout } from "../../content/home-motion";

const photo = homeAbout.photo;
---

<section id="about" class="hm-about">
  <div class="hm-wrap hm-section hm-about-grid">
    <div class="hm-about-copy">
      <p class="hm-kicker" data-i18n-path="hm.aboutBlock.kicker">{homeAbout.kicker}</p>
      <h2 data-i18n-path="hm.aboutBlock.heading">{homeAbout.heading}</h2>
      <p data-i18n-path="hm.aboutBlock.p1">{homeAbout.p1}</p>
      <p data-i18n-path="hm.aboutBlock.p2">{homeAbout.p2}</p>
      <ul class="hm-about-points">
        {
          homeAbout.points.map((point, i) => (
            <li>
              <span class="hm-about-icon">
                <HomeIcon name={point.icon} size={22} />
              </span>
              <span>
                <strong data-i18n-path={`hm.aboutBlock.points.${i}.title`}>{point.title}</strong>
                <span data-i18n-path={`hm.aboutBlock.points.${i}.body`}>{point.body}</span>
              </span>
            </li>
          ))
        }
      </ul>
      <p class="hm-about-facts">
        <span data-i18n-path="hm.aboutBlock.ahpra">{homeAbout.ahpra}</span>
        {
          site.disclaimer.showInsuranceStatement && (
            <span data-i18n-path="hm.aboutBlock.insurance">{homeAbout.insurance}</span>
          )
        }
      </p>
    </div>
    <div class="hm-about-visual">
      <div class="hm-about-frame">
        <HomePicture
          photo={photo}
          altPath="hm.aboutBlock.photoAlt"
          sizes="(min-width: 1024px) 520px, (min-width: 768px) 680px, calc(100vw - 2.5rem)"
        />
        <p class="hm-photo-label" data-i18n-path="hm.aboutBlock.caption">{homeAbout.caption}</p>
        <div class="hm-about-card">
          <p class="hm-about-card-title" data-i18n-path="hm.aboutBlock.cardTitle">{homeAbout.cardTitle}</p>
          <p data-i18n-path="hm.aboutBlock.cardBody">{homeAbout.cardBody}</p>
          <a class="hm-btn hm-btn-primary" href="/enquiry/">
            <span data-i18n-path="hm.banner.enquire">Make an enquiry</span>
            <span class="hm-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
