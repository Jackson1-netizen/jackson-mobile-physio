---
import HomePicture from "./HomePicture.astro";
import BandCta from "./BandCta.astro";
import { site, publicQualifications } from "../../content/site";
import { messages } from "../../content/i18n";
import { homeAbout, homeMedia, homeWhy } from "../../content/home-motion";

const caption = "Preview placeholder — to be replaced with genuine photography";
const alt = "Preview placeholder portrait of a person in a polo shirt. Not a documented visit.";
const insurance = publicQualifications().filter((item) => item.label === "Professional insurance");
---

<section id="about" class="a-band a-band-sand" aria-labelledby="about-heading">
  <div class="a-wrap a-about-grid">
    <div class="a-about-head">
      <h2 id="about-heading" data-i18n-path="about.heading">{homeAbout.heading}</h2>
      <p class="a-name" translate="no">{site.practitionerName}</p>
      <p class="a-role" data-i18n-path="about.role">{homeAbout.role}</p>
    </div>
    <figure class="a-figure a-about-figure">
      <div class="a-frame">
        <HomePicture
          photo={{ ...homeMedia.about, alt }}
          sizes="(min-width: 800px) 320px, calc(100vw - 2rem)"
        />
      </div>
      <figcaption class="a-caption">{caption}</figcaption>
    </figure>
    <div class="a-about-body a-about-copy">
      {
        homeAbout.paragraphs.map((paragraph, i) => (
          <p class="a-prose" data-i18n-path={`about.paragraphs.${i}`}>
            {paragraph}
          </p>
        ))
      }
      <p class="a-lang-line">
        <strong data-i18n-path="about.languagesLabel">{homeAbout.languagesLabel}</strong>{": "}
        <span data-i18n-path="hm.about.languagesList">{messages.en.hm.about.languagesList}</span>
      </p>
      <div class="a-why">
        <h3 data-i18n-path="hm.why.heading">{homeWhy.heading}</h3>
        <p class="a-prose" data-i18n-path="hm.why.intro">{homeWhy.intro}</p>
        <ul class="a-why-list">
          {
            homeWhy.items.map((item, i) => (
              <li>
                <strong data-i18n-path={`hm.why.items.${i}.title`}>{item.title}</strong>
                <p data-i18n-path={`hm.why.items.${i}.body`}>{item.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <p class="a-trust" data-i18n-path="hm.about.ahpraNotice">{site.ahpraNotice}</p>
      {
        insurance.map((item) => (
          <p class="a-trust">
            {item.label}: {item.value}
          </p>
        ))
      }
      <BandCta />
    </div>
  </div>
</section>
