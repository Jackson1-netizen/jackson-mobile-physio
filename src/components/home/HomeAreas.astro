---
import BandCta from "./BandCta.astro";
import ServiceAreaMap from "./ServiceAreaMap.astro";
import { messages } from "../../content/i18n";
import { homeAreas, homeSuburbs } from "../../content/home-motion";
import { site } from "../../content/site";
---

<section id="areas" class="a-band a-band-sand" aria-labelledby="areas-heading">
  <div class="a-wrap">
    <h2 id="areas-heading" data-i18n-path="hm.areas.heading">{homeAreas.kicker}</h2>
    <p class="a-lede" data-i18n-path="hm.areas.lead">{homeAreas.heading}</p>
    <ul class="a-suburbs">
      {
        homeSuburbs.map((suburb) => (
          <li>
            <a href={suburb.href}>{suburb.name}</a>
          </li>
        ))
      }
    </ul>
    <p class="a-note">{site.serviceAreas.surroundingNote}</p>
    <p class="a-note" data-i18n-path="areas.intro">{messages.en.areas.intro}</p>
    <div class="a-map-block">
      <ServiceAreaMap />
      <p class="a-caption" data-i18n-path="hm.areas.mapCaption">{homeAreas.mapCaption}</p>
    </div>
    <BandCta />
  </div>
</section>
