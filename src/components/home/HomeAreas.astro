---
import { site } from "../../content/site";
import { homeAreas, homeCardEmail, homeMedia, homeSuburbs } from "../../content/home-motion";
import ServiceAreaMap from "./ServiceAreaMap.astro";
import HomeIcon from "./HomeIcon.astro";

// homeCardEmail is a draft visual on the card only — not site.email and not a confirmed inbox.
---

<section id="areas" class="hm-areas-band">
  <div class="hm-areas-split">
    <div class="hm-card-stage" style={`--hm-areas-photo: url('${homeMedia.areasBackdrop.src}')`}>
      <div class="hm-card-stack" role="group" aria-label={homeAreas.cardLabel} data-i18n-attr="aria-label:hm.areas.cardLabel">
        <article class="hm-print-card hm-print-card-back">
          <img src="/home-motion-logo.png" alt="" width="180" height="56" />
        </article>
        <article class="hm-print-card hm-print-card-front">
          <p class="hm-print-name">Jackson</p>
          <p class="hm-print-role">Mobile Physiotherapist</p>
          <p class="hm-print-phone"><a href={site.phoneHref}>{site.phone}</a></p>
          <p class="hm-print-email">{homeCardEmail}</p>
          <div class="hm-print-foot">
            <p class="hm-print-place">{homeAreas.cardPlace}</p>
            <p class="hm-print-motto">{homeAreas.motto}</p>
          </div>
        </article>
      </div>
    </div>
    <div class="hm-areas-copy">
      <div class="hm-areas-copy-text">
        <h2 data-i18n-path="hm.areas.heading">{homeAreas.kicker}</h2>
        <p data-i18n-path="hm.areas.lead">{homeAreas.heading}</p>
        <ul class="hm-pin-list">
          {
            homeSuburbs.map((suburb) => (
              <li>
                <a href={suburb.href}>
                  <span class="hm-pin">
                    <HomeIcon name="pin" size={18} />
                  </span>
                  {suburb.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="hm-areas-map-col">
        <ServiceAreaMap />
        <p class="hm-map-caption" data-i18n-path="hm.areas.mapCaption">{homeAreas.mapCaption}</p>
      </div>
    </div>
  </div>
</section>
