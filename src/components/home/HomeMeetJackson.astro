---
import HomePicture from "./HomePicture.astro";
import { site, publicQualifications } from "../../content/site";
import { homeMeetJackson as homeAbout } from "../../content/home-motion";
import { messages } from "../../content/i18n";

const photo = homeAbout.photo;
const shownQualifications = publicQualifications().map((item) => ({
  item,
  index: site.qualifications.indexOf(item),
}));
---

<section id="meet-jackson" class="hm-reveal hm-meet">
  <div class="hm-wrap hm-section hm-about-grid">
    <div class="hm-mobile-approved-only hm-meet-mobile-heading">
      <p class="hm-kicker" data-i18n-path="sections.about">{homeAbout.kicker}</p>
      <h2 data-i18n-path="about.heading">{homeAbout.heading}</h2>
    </div>
    <div class="hm-portrait hm-img-zoom">
      <HomePicture
        photo={photo}
        altPath="hm.about.portraitAlt"
        sizes="(min-width: 1024px) 556px, (min-width: 768px) 728px, calc(100vw - 2.5rem)"
      />
    </div>
    <div>
      <p class="hm-kicker hm-mobile-approved-desktop" data-i18n-path="sections.about">{homeAbout.kicker}</p>
      <h2 class="hm-mobile-approved-desktop" data-i18n-path="about.heading">{homeAbout.heading}</h2>
      <p class="hm-about-name">{homeAbout.name}</p>
      <p class="hm-about-role" data-i18n-path="about.role">{homeAbout.role}</p>
      {
        homeAbout.paragraphs.map((p, i) => (
          <p class="mt-4 text-[#3d5a52] hm-mobile-approved-desktop" data-i18n-path={`about.paragraphs.${i}`}>
            {p}
          </p>
        ))
      }
      {messages.en.hm.mobileApproved.meetParagraphs.map((p, i) => (
        <p class="hm-mobile-approved-only hm-meet-mobile-paragraph" data-i18n-path={`hm.mobileApproved.meetParagraphs.${i}`}>{p}</p>
      ))}
      <p class="mt-4 font-medium hm-meet-philosophy" data-i18n-path="about.differentiator">{homeAbout.philosophy}</p>
      <p class="mt-5 text-[#3d5a52] hm-mobile-approved-desktop">
        <strong><span data-i18n-path="about.languagesLabel">{homeAbout.languagesLabel}</span>:</strong>
        {" "}
        <span data-i18n-path="hm.about.languagesList">{site.languages.join(", ")}</span>
      </p>
      {
        shownQualifications.length > 0 && (
          <p class="mt-3 text-sm text-[#3d5a52] hm-mobile-approved-desktop">
            <strong>
              <span data-i18n-path="about.qualificationsLabel">{homeAbout.qualificationsLabel}</span>:
            </strong>{" "}
            {shownQualifications.map(({ item, index }, visibleIndex) => (
              <>
                {visibleIndex > 0 && "; "}
                <span data-i18n-path={`hm.about.qualificationLabels.${index}`}>{item.label}</span>
                {": "}
                <span data-i18n-path={`hm.about.qualificationValues.${index}`}>{item.value}</span>
              </>
            ))}
          </p>
        )
      }
      <dl class="hm-mobile-approved-only hm-meet-mobile-facts">
        <div><dt data-i18n-path="about.languagesLabel">{homeAbout.languagesLabel}</dt><dd data-i18n-path="hm.mobileApproved.languages">{messages.en.hm.mobileApproved.languages}</dd></div>
        {shownQualifications.map(({ item, index }) => (
          <div><dt data-i18n-path={`hm.about.qualificationLabels.${index}`}>{item.label}</dt><dd data-i18n-path={`hm.about.qualificationValues.${index}`}>{item.value}</dd></div>
        ))}
      </dl>
      <p class="hm-registered" data-i18n-path="hm.about.ahpraNotice">{site.ahpraNotice}</p>
    </div>
  </div>
</section>
