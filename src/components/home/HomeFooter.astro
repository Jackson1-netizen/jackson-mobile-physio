---
import HomeLogo from "./HomeLogo.astro";
import { site, getEmailHref } from "../../content/site";
import { messages } from "../../content/i18n";

const publicMailto = getEmailHref();
---

<footer class="hm-footer">
  <div class="hm-wrap hm-footer-inner">
    <a
      class="hm-logo"
      href="/"
      aria-label={messages.en.hm.header.logoLabel}
      data-i18n-attr="aria-label:hm.header.logoLabel"
    >
      <HomeLogo sizes="88px" lazy />
    </a>
    <p class="text-sm text-[#5b6e67]">
      {site.registeredBusinessName} · {site.abnDisplay} · AHPRA registered physiotherapist
    </p>
    <p class="text-sm text-[#5b6e67]">
      <span data-i18n-path="hm.footer.rights">{site.footer.copyrightSuffix}</span>
    </p>
    <p class="flex flex-wrap gap-4 text-sm">
      <a class="underline-offset-4 hover:underline" href={site.phoneHref}>{site.phone}</a>
      <a class="underline-offset-4 hover:underline" href={publicMailto}>{site.publicEmail}</a>
      <a class="underline-offset-4 hover:underline" href="/privacy/" data-i18n-path="hm.footer.privacy">
        {site.footer.privacyLinkLabel}
      </a>
      <a class="underline-offset-4 hover:underline" href="/disclaimer/" data-i18n-path="hm.footer.disclaimer">
        {site.footer.disclaimerLinkLabel}
      </a>
      <a class="underline-offset-4 hover:underline" href="/referral/" data-i18n-path="nav.referralSheet">
        {messages.en.nav.referralSheet}
      </a>
    </p>
  </div>
</footer>
