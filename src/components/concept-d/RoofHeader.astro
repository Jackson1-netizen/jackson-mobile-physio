---
import HomeLogo from "../home/HomeLogo.astro";
import RoofLang from "./RoofLang.astro";
import { site } from "../../content/site";
import { messages } from "../../content/i18n";

const t = messages.en.hm.header;
const nav = messages.en.nav;
const links = [
  { href: "/#services", label: nav.services, path: "nav.services" },
  { href: "/#visit", label: nav.howItWorks, path: "nav.howItWorks" },
  { href: "/#areas", label: nav.areas, path: "nav.areas" },
  { href: "/#referrers", label: nav.refer, path: "nav.refer" },
];
---

<header class="roof-header no-print">
  <div class="roof-wrap roof-header-inner">
    <a class="roof-brand" href="/" aria-label={t.logoLabel} data-i18n-attr="aria-label:hm.header.logoLabel" translate="no">
      <HomeLogo alt="" sizes="140px" />
    </a>

    <nav class="roof-nav" aria-label={t.primaryNav} data-i18n-attr="aria-label:hm.header.primaryNav">
      {
        links.map((item) => (
          <a href={item.href} data-i18n-path={item.path}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="roof-header-end">
      <RoofLang />
      <a class="roof-pill roof-pill-outline roof-header-pill" href="/#contact">
        <span data-i18n-path="home.primaryCta">{messages.en.home.primaryCta}</span>
      </a>
      <button
        type="button"
        class="roof-menu-button"
        data-roof-menu
        aria-expanded="false"
        aria-controls="roof-menu"
        aria-label={t.menu}
        data-i18n-attr="aria-label:hm.header.menu"
      >
        <span class="roof-menu-glyph" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<dialog
  id="roof-menu"
  class="roof-menu"
  data-roof-dialog
  closedby="any"
  aria-label={t.mobileNav}
  data-i18n-attr="aria-label:hm.header.mobileNav"
>
  <div class="roof-menu-inner">
    <div class="roof-menu-top">
      <p class="roof-menu-title" translate="no">{site.businessName}</p>
      <button type="button" class="roof-menu-button" data-roof-close aria-label="Close">
        <span aria-hidden="true">×</span>
      </button>
    </div>
    <nav aria-label={t.mobileNav} data-i18n-attr="aria-label:hm.header.mobileNav">
      {
        links.map((item) => (
          <a href={item.href} data-i18n-path={item.path}>
            {item.label}
          </a>
        ))
      }
      <a href="/#contact" data-i18n-path="nav.contact">{nav.contact}</a>
      <a href="/#faq" data-i18n-path="nav.faq">{nav.faq}</a>
    </nav>
    <RoofLang />
    <a class="roof-pill roof-pill-orange" href="/#contact">
      <span data-i18n-path="home.primaryCta">{messages.en.home.primaryCta}</span>
    </a>
  </div>
</dialog>

<script>
  const button = document.querySelector("[data-roof-menu]");
  const dialog = document.querySelector("[data-roof-dialog]");
  if (button instanceof HTMLButtonElement && dialog instanceof HTMLDialogElement) {
    const setExpanded = (open: boolean) => {
      button.setAttribute("aria-expanded", open ? "true" : "false");
    };
    button.addEventListener("click", () => {
      if (dialog.open) {
        dialog.close();
        return;
      }
      dialog.showModal();
      setExpanded(true);
    });
    dialog.addEventListener("close", () => {
      setExpanded(false);
      button.focus();
    });
    dialog.querySelector("[data-roof-close]")?.addEventListener("click", () => {
      dialog.close();
    });
    dialog.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        if (dialog.open) dialog.close();
      });
    });
    if (!("closedBy" in HTMLDialogElement.prototype)) {
      dialog.addEventListener("click", (event) => {
        if (event.target !== dialog) return;
        const rect = dialog.getBoundingClientRect();
        const inside =
          rect.top <= event.clientY &&
          event.clientY <= rect.bottom &&
          rect.left <= event.clientX &&
          event.clientX <= rect.right;
        if (!inside) dialog.close();
      });
    }
  }
</script>
