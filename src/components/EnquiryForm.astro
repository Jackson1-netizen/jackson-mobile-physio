---
import { site } from "../content/site";
import { messages } from "../content/i18n";

const t = messages.en.enquiry;
const enquiryMessages = {
  en: messages.en.enquiry,
  "zh-Hant": messages["zh-Hant"].enquiry,
  "zh-Hans": messages["zh-Hans"].enquiry,
};
const suburbs = site.serviceAreas.suburbs;
const roleValues = ["Myself", "A family member", "A carer or support coordinator", "A referrer or health professional", "Other"];
const serviceValues = [
  "Mobile Physiotherapy",
  "Mobility & Balance",
  "Strength & Functional Capacity",
  "Rehabilitation After Hospitalisation",
  "Neurological & Disability-Related",
  "Home Exercise Programs",
];
const fundingValues = ["NDIS", "Home Care Package", "Private", "Not sure"];
const contactValues = ["Phone", "Email", "Either"];
---

<form
  id="enquiry-form"
  class="hm-form hm-form-card"
  name="enquiry"
  method="POST"
  action="/enquiry-received/"
  data-netlify="true"
  netlify-honeypot="bot-field"
  novalidate
  aria-describedby="enq-required-note"
>
  <input type="hidden" name="form-name" value="enquiry" />
  <input type="hidden" name="language" value="" />
  <input type="hidden" name="ndis" value="" />
  <p class="hm-honeypot" aria-hidden="true">
    <label>
      Leave this blank
      <input name="bot-field" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  <div id="enq-fields">
    <fieldset class="hm-form-grid">
      <legend class="sr-only" data-i18n-path="sections.enquiry">Send an enquiry</legend>
      <p id="enq-required-note" class="hm-form-note hm-form-span" data-i18n-path="enquiry.requiredNote">{t.requiredNote}</p>

      <div class="hm-field">
        <label for="enq-name">
          <span data-i18n-path="enquiry.name">{t.name}</span>
          <span class="hm-req" aria-hidden="true">*</span>
        </label>
        <input
          id="enq-name"
          class="hm-input"
          type="text"
          name="name"
          autocomplete="name"
          enterkeyhint="next"
          required
          maxlength="100"
        />
        <p id="enq-name-error" class="hm-field-error" hidden></p>
      </div>

      <div class="hm-field">
        <label for="enq-role">
          <span data-i18n-path="enquiry.role">{t.role}</span>
          <span class="hm-req" aria-hidden="true">*</span>
        </label>
        <select id="enq-role" class="hm-input hm-select" name="enquiring-as" required>
          <option value="" data-i18n-path="enquiry.selectOne">{t.selectOne}</option>
          {
            roleValues.map((value, i) => (
              <option value={value} data-i18n-path={`enquiry.roleOptions.${i}`}>
                {t.roleOptions[i]}
              </option>
            ))
          }
        </select>
        <p id="enq-role-error" class="hm-field-error" hidden></p>
      </div>

      <div class="hm-field">
        <label for="enq-email">
          <span data-i18n-path="enquiry.email">{t.email}</span>
          <span class="hm-req" aria-hidden="true">*</span>
        </label>
        <input
          id="enq-email"
          class="hm-input"
          type="email"
          name="email"
          autocomplete="email"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          enterkeyhint="next"
          required
          maxlength="254"
        />
        <p id="enq-email-error" class="hm-field-error" hidden></p>
      </div>

      <div class="hm-field">
        <label for="enq-phone">
          <span data-i18n-path="enquiry.phone">{t.phone}</span>
          <span class="hm-req" aria-hidden="true">*</span>
        </label>
        <input
          id="enq-phone"
          class="hm-input"
          type="tel"
          name="phone"
          autocomplete="tel"
          inputmode="tel"
          enterkeyhint="next"
          required
          maxlength="20"
        />
        <p id="enq-phone-error" class="hm-field-error" hidden></p>
      </div>

      <div class="hm-field hm-form-span">
        <label for="enq-suburb">
          <span data-i18n-path="enquiry.suburb">{t.suburb}</span>
          <span class="hm-req" aria-hidden="true">*</span>
        </label>
        <input
          id="enq-suburb"
          class="hm-input"
          type="text"
          name="suburb"
          autocomplete="address-level2"
          enterkeyhint="next"
          list="enq-suburbs"
          required
          maxlength="80"
          aria-describedby="enq-suburb-hint"
        />
        <datalist id="enq-suburbs">
          {suburbs.map((name) => <option value={name} />)}
        </datalist>
        <p id="enq-suburb-hint" class="hm-form-note" data-i18n-path="enquiry.suburbHint">{t.suburbHint}</p>
        <p id="enq-suburb-error" class="hm-field-error" hidden></p>
      </div>

      <div class="hm-field">
        <label for="enq-service">
          <span data-i18n-path="enquiry.service">{t.service}</span>
          <span class="hm-optional" data-i18n-path="enquiry.optional">{t.optional}</span>
        </label>
        <select id="enq-service" class="hm-input hm-select" name="service">
          <option value="" data-i18n-path="enquiry.selectOne">{t.selectOne}</option>
          {
            serviceValues.map((value, i) => (
              <option value={value} data-i18n-path={`enquiry.serviceOptions.${i}`}>
                {t.serviceOptions[i]}
              </option>
            ))
          }
        </select>
      </div>

      <div class="hm-field">
        <label for="enq-funding">
          <span data-i18n-path="enquiry.funding">{t.funding}</span>
          <span class="hm-optional" data-i18n-path="enquiry.optional">{t.optional}</span>
        </label>
        <select id="enq-funding" class="hm-input hm-select" name="funding" aria-describedby="enq-funding-hint">
          <option value="" data-i18n-path="enquiry.selectOne">{t.selectOne}</option>
          {
            fundingValues.map((value, i) => (
              <option value={value} data-i18n-path={`enquiry.fundingOptions.${i}`}>
                {t.fundingOptions[i]}
              </option>
            ))
          }
        </select>
        <p id="enq-funding-hint" class="hm-form-note" data-i18n-path="enquiry.fundingHint">{t.fundingHint}</p>
      </div>

      <div class="hm-field">
        <label for="enq-preferred">
          <span data-i18n-path="enquiry.preferredContact">{t.preferredContact}</span>
          <span class="hm-optional" data-i18n-path="enquiry.optional">{t.optional}</span>
        </label>
        <select id="enq-preferred" class="hm-input hm-select" name="preferred-contact">
          <option value="" data-i18n-path="enquiry.selectOne">{t.selectOne}</option>
          {
            contactValues.map((value, i) => (
              <option value={value} data-i18n-path={`enquiry.preferredContactOptions.${i}`}>
                {t.preferredContactOptions[i]}
              </option>
            ))
          }
        </select>
      </div>

      <div class="hm-field">
        <label for="enq-time">
          <span data-i18n-path="enquiry.preferredTime">{t.preferredTime}</span>
          <span class="hm-optional" data-i18n-path="enquiry.optional">{t.optional}</span>
        </label>
        <input id="enq-time" class="hm-input" type="text" name="preferred-time" autocomplete="off" maxlength="80" />
      </div>

      <div class="hm-field hm-form-span">
        <label for="enq-message">
          <span data-i18n-path="enquiry.help">{t.help}</span>
          <span class="hm-optional" data-i18n-path="enquiry.optional">{t.optional}</span>
        </label>
        <textarea
          id="enq-message"
          class="hm-input"
          name="message"
          rows="4"
          maxlength="1000"
          aria-describedby="enq-help-hint"
        ></textarea>
        <p id="enq-help-hint" class="hm-form-note" data-i18n-path="enquiry.helpHint">{t.helpHint}</p>
      </div>

      <div class="hm-field hm-field-check hm-form-span">
        <input id="enq-consent" type="checkbox" name="consent" value="yes" required />
        <div>
          <label for="enq-consent">
            <span data-i18n-path="enquiry.consentLead">{t.consentLead}</span>
          </label>
          {" "}
          <a href="/privacy/" data-i18n-path="enquiry.privacyNotice">{t.privacyNotice}</a>.
          <p id="enq-consent-error" class="hm-field-error" hidden></p>
        </div>
      </div>
    </fieldset>

    <noscript>
      <p class="hm-form-unavailable">
        <span data-i18n-path="enquiry.noscript">{t.noscript}</span>{" "}
        <a href={site.phoneHref}>{site.phone}</a>
      </p>
    </noscript>

    <button type="submit" class="hm-btn hm-btn-forest hm-form-submit">
      <span data-i18n-path="enquiry.submitLabel">{t.submitLabel}</span>
      <span class="hm-arrow" aria-hidden="true">→</span>
    </button>
  </div>

  <div id="enq-feedback" class="hm-form-feedback" role="status" aria-live="polite" tabindex="-1">
    <div data-feedback="errors" hidden>
      <p data-i18n-path="enquiry.errorSummary">{t.errorSummary}</p>
    </div>
    <div data-feedback="success" hidden>
      <p class="hm-form-feedback-title" data-i18n-path="enquiry.successTitle">{t.successTitle}</p>
      <p>
        <span data-i18n-path="enquiry.successBody">{t.successBody}</span>{" "}
        <a class="hm-form-call" href={site.phoneHref}>{site.phone}</a>.
      </p>
    </div>
    <div data-feedback="failed" hidden>
      <p class="hm-form-feedback-title" data-i18n-path="enquiry.failedTitle">{t.failedTitle}</p>
      <p>
        <span data-i18n-path="enquiry.failedBody">{t.failedBody}</span>{" "}
        <a class="hm-form-call" href={site.phoneHref}>{site.phone}</a>
      </p>
    </div>
  </div>
</form>

<script define:vars={{ enquiryMessages }}>
  const form = document.getElementById("enquiry-form");
  if (form) {
    const feedback = form.querySelector("#enq-feedback");
    const fieldsWrap = form.querySelector("#enq-fields");
    const submitButton = form.querySelector("button[type=submit]");
    const fields = {
      name: form.querySelector("#enq-name"),
      role: form.querySelector("#enq-role"),
      email: form.querySelector("#enq-email"),
      phone: form.querySelector("#enq-phone"),
      suburb: form.querySelector("#enq-suburb"),
      consent: form.querySelector("#enq-consent"),
    };
    let attempted = false;

    const currentMessages = () => {
      const lang = document.documentElement.lang;
      const key = lang === "zh-Hant" || lang === "zh-Hans" ? lang : "en";
      return enquiryMessages[key] || enquiryMessages.en;
    };

    const checkField = (name) => {
      if (name === "consent") return fields.consent.checked ? null : "consentRequired";
      const value = fields[name].value.trim();
      if (name === "name") return value ? null : "nameRequired";
      if (name === "role") return value ? null : "roleRequired";
      if (name === "email") {
        if (!value) return "emailRequired";
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value) ? null : "emailInvalid";
      }
      if (name === "phone") {
        if (!value) return "phoneRequired";
        const digits = value.replace(/\D/g, "");
        return /^[+\d\s().-]+$/.test(value) && digits.length >= 8 && digits.length <= 15
          ? null
          : "phoneInvalid";
      }
      if (name === "suburb") return value ? null : "suburbRequired";
      return null;
    };

    const showFieldState = (name, errorKey) => {
      const input = fields[name];
      const error = form.querySelector(`#enq-${name}-error`);
      const hint = name === "suburb" ? "enq-suburb-hint" : "";
      if (errorKey) {
        error.setAttribute("data-i18n-path", `enquiry.errors.${errorKey}`);
        error.textContent = currentMessages().errors[errorKey];
        error.hidden = false;
        input.setAttribute("aria-invalid", "true");
        input.setAttribute("aria-describedby", hint ? `${hint} ${error.id}` : error.id);
      } else {
        error.removeAttribute("data-i18n-path");
        error.textContent = "";
        error.hidden = true;
        input.removeAttribute("aria-invalid");
        if (hint) input.setAttribute("aria-describedby", hint);
        else input.removeAttribute("aria-describedby");
      }
    };

    const showFeedback = (kind) => {
      feedback.querySelectorAll("[data-feedback]").forEach((block) => {
        block.hidden = block.getAttribute("data-feedback") !== kind;
      });
      feedback.classList.toggle("is-error", kind === "errors" || kind === "failed");
      feedback.classList.toggle("is-visible", Boolean(kind));
    };

    Object.keys(fields).forEach((name) => {
      const handler = () => {
        if (!attempted) return;
        showFieldState(name, checkField(name));
        if (!form.querySelector("[aria-invalid='true']")) showFeedback(null);
      };
      fields[name].addEventListener("input", handler);
      fields[name].addEventListener("change", handler);
      fields[name].addEventListener("blur", handler);
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      attempted = true;
      let firstInvalid = null;
      for (const name of Object.keys(fields)) {
        const errorKey = checkField(name);
        showFieldState(name, errorKey);
        if (errorKey && !firstInvalid) firstInvalid = fields[name];
      }
      if (firstInvalid) {
        showFeedback("errors");
        firstInvalid.focus();
        return;
      }

      const bot = form.querySelector("[name=bot-field]");
      if (bot && bot.value) return;

      const funding = form.querySelector("#enq-funding");
      const ndis = form.querySelector("[name=ndis]");
      if (ndis && funding) {
        ndis.value = funding.value === "NDIS" ? "Yes — plan-managed or self-managed" : "";
      }

      const messagesNow = currentMessages();
      const label = submitButton.querySelector("span");
      submitButton.disabled = true;
      submitButton.setAttribute("aria-busy", "true");
      if (label) label.textContent = messagesNow.sending;

      try {
        const body = new URLSearchParams(new FormData(form)).toString();
        const response = await fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body,
        });
        if (!response.ok) throw new Error("Form was not accepted");
        fieldsWrap.hidden = true;
        showFeedback("success");
        feedback.focus();
      } catch {
        showFeedback("failed");
        feedback.focus();
        submitButton.disabled = false;
        submitButton.removeAttribute("aria-busy");
        if (label) label.textContent = messagesNow.submitLabel;
      }
    });
  }
</script>
