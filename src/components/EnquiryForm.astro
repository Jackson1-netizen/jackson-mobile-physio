---
import { site, getEmailHref } from "../content/site";
import { messages } from "../content/i18n";

const t = messages.en.enquiry;
const publicMailto = getEmailHref("Enquiry — Home Motion");
const enquiryMessages = {
  en: messages.en.enquiry,
  "zh-Hant": messages["zh-Hant"].enquiry,
  "zh-Hans": messages["zh-Hans"].enquiry,
};
const languageValues = ["English", "Cantonese", "Mandarin", "No preference"];
---

<form
  id="enquiry-form"
  class="hm-form"
  name="enquiry"
  method="POST"
  action="/enquiry-received/"
  data-netlify="true"
  netlify-honeypot="bot-field"
  novalidate
  aria-describedby="enq-required-note"
>
  <input type="hidden" name="form-name" value="enquiry" />
  <p class="hm-honeypot" hidden>
    <label>
      Leave this blank
      <input name="bot-field" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  <div id="enq-fields">
    <p id="enq-required-note" class="hm-form-note" data-i18n-path="enquiry.requiredNote">{t.requiredNote}</p>

    <div class="grid gap-4 sm:grid-cols-2">
      <div class="hm-field">
        <label for="enq-name">
          <span data-i18n-path="enquiry.name">{t.name}</span>
          <span class="hm-req" aria-hidden="true">*</span>
        </label>
        <input id="enq-name" class="hm-input" type="text" name="name" autocomplete="name" required />
        <p id="enq-name-error" class="hm-field-error" hidden></p>
      </div>
      <div class="hm-field">
        <label for="enq-phone">
          <span data-i18n-path="enquiry.phone">{t.phone}</span>
          <span class="hm-req" aria-hidden="true">*</span>
        </label>
        <input
          id="enq-phone"
          class="hm-input"
          type="tel"
          name="phone"
          autocomplete="tel"
          inputmode="tel"
          required
        />
        <p id="enq-phone-error" class="hm-field-error" hidden></p>
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div class="hm-field">
        <label for="enq-email">
          <span data-i18n-path="enquiry.email">{t.email}</span>
          <span class="hm-optional" data-i18n-path="enquiry.optional">{t.optional}</span>
        </label>
        <input id="enq-email" class="hm-input" type="email" name="email" autocomplete="email" />
        <p id="enq-email-error" class="hm-field-error" hidden></p>
      </div>
      <div class="hm-field">
        <label for="enq-suburb">
          <span data-i18n-path="enquiry.suburb">{t.suburb}</span>
          <span class="hm-optional" data-i18n-path="enquiry.optional">{t.optional}</span>
        </label>
        <input id="enq-suburb" class="hm-input" type="text" name="suburb" autocomplete="address-level2" />
      </div>
    </div>

    <div class="hm-field">
      <label for="enq-language">
        <span data-i18n-path="enquiry.language">{t.language}</span>
      </label>
      <select id="enq-language" class="hm-input hm-select" name="language" autocomplete="off">
        {
          languageValues.map((value, i) => (
            <option value={value} data-i18n-path={`enquiry.languageOptions.${i}`}>
              {t.languageOptions[i]}
            </option>
          ))
        }
      </select>
    </div>

    <div class="hm-field hm-field-check">
      <input id="enq-ndis" type="checkbox" name="ndis" value="Yes — plan-managed or self-managed" />
      <label for="enq-ndis" data-i18n-path="enquiry.ndisLabel">{t.ndisLabel}</label>
    </div>

    <div class="hm-field">
      <label for="enq-message">
        <span data-i18n-path="enquiry.message">{t.message}</span>
        <span class="hm-optional" data-i18n-path="enquiry.optional">{t.optional}</span>
      </label>
      <textarea id="enq-message" class="hm-input" name="message" rows="3" maxlength="400" aria-describedby="enq-privacy-note"></textarea>
    </div>

    <p id="enq-privacy-note" class="hm-form-note">
      <span data-i18n-path="enquiry.privacyNote">{t.privacyNote}</span>{" "}
      <a href="/privacy" data-i18n-path="enquiry.privacyLink">{t.privacyLink}</a>.
    </p>

    <noscript>
      <p class="hm-form-unavailable">
        <span data-i18n-path="enquiry.noscript">{t.noscript}</span>{" "}
        <a href={site.phoneHref}>{site.phone}</a>
      </p>
    </noscript>

    <button type="submit" class="hm-btn hm-btn-primary hm-form-submit">
      <span data-i18n-path="enquiry.submit">{t.submit}</span>
    </button>
  </div>

  <p class="hm-form-secondary">
    <span data-i18n-path="enquiry.secondaryLead">{t.secondaryLead}</span>{" "}
    <a href={publicMailto}>{site.publicEmail}</a>
  </p>

  <div id="enq-feedback" class="hm-form-feedback" role="status" aria-live="polite" tabindex="-1">
    <div data-feedback="errors" hidden>
      <p data-i18n-path="enquiry.errorSummary">{t.errorSummary}</p>
    </div>
    <div data-feedback="success" hidden>
      <p class="hm-form-feedback-title" data-i18n-path="enquiry.successTitle">{t.successTitle}</p>
      <p>
        <span data-i18n-path="enquiry.successBody">{t.successBody}</span>{" "}
        <a class="hm-form-call" href={site.phoneHref}>{site.phone}</a>.
      </p>
    </div>
    <div data-feedback="failed" hidden>
      <p class="hm-form-feedback-title" data-i18n-path="enquiry.failedTitle">{t.failedTitle}</p>
      <p>
        <span data-i18n-path="enquiry.failedBody">{t.failedBody}</span>{" "}
        <a class="hm-form-call" href={site.phoneHref}>{site.phone}</a>
      </p>
    </div>
  </div>
</form>

<script define:vars={{ enquiryMessages }}>
  const form = document.getElementById("enquiry-form");
  if (form) {
    const feedback = form.querySelector("#enq-feedback");
    const fieldsWrap = form.querySelector("#enq-fields");
    const submitButton = form.querySelector("button[type=submit]");
    const fields = {
      name: form.querySelector("#enq-name"),
      phone: form.querySelector("#enq-phone"),
      email: form.querySelector("#enq-email"),
    };
    let attempted = false;

    const currentMessages = () => {
      const lang = document.documentElement.lang;
      const key = lang === "zh-Hant" || lang === "zh-Hans" ? lang : "en";
      return enquiryMessages[key] || enquiryMessages.en;
    };

    const checkField = (name) => {
      const value = fields[name].value.trim();
      if (name === "name") return value ? null : "nameRequired";
      if (name === "phone") {
        if (!value) return "phoneRequired";
        const digits = value.replace(/\D/g, "");
        return /^[+\d\s().-]+$/.test(value) && digits.length >= 8 && digits.length <= 15
          ? null
          : "phoneInvalid";
      }
      if (name === "email") {
        return !value || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value) ? null : "emailInvalid";
      }
      return null;
    };

    const showFieldState = (name, errorKey) => {
      const input = fields[name];
      const error = form.querySelector(`#enq-${name}-error`);
      if (errorKey) {
        error.setAttribute("data-i18n-path", `enquiry.errors.${errorKey}`);
        error.textContent = currentMessages().errors[errorKey];
        error.hidden = false;
        input.setAttribute("aria-invalid", "true");
        input.setAttribute("aria-describedby", error.id);
      } else {
        error.removeAttribute("data-i18n-path");
        error.textContent = "";
        error.hidden = true;
        input.removeAttribute("aria-invalid");
        input.removeAttribute("aria-describedby");
      }
    };

    const showFeedback = (kind) => {
      feedback.querySelectorAll("[data-feedback]").forEach((block) => {
        block.hidden = block.getAttribute("data-feedback") !== kind;
      });
      feedback.classList.toggle("is-error", kind === "errors" || kind === "failed");
      feedback.classList.toggle("is-visible", Boolean(kind));
    };

    Object.keys(fields).forEach((name) => {
      const handler = () => {
        if (!attempted) return;
        showFieldState(name, checkField(name));
        if (!form.querySelector("[aria-invalid='true']")) showFeedback(null);
      };
      fields[name].addEventListener("input", handler);
      fields[name].addEventListener("blur", handler);
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      attempted = true;
      let firstInvalid = null;
      for (const name of Object.keys(fields)) {
        const errorKey = checkField(name);
        showFieldState(name, errorKey);
        if (errorKey && !firstInvalid) firstInvalid = fields[name];
      }
      if (firstInvalid) {
        showFeedback("errors");
        firstInvalid.focus();
        return;
      }

      const bot = form.querySelector("[name=bot-field]");
      if (bot && bot.value) return;

      const messagesNow = currentMessages();
      const label = submitButton.querySelector("span");
      submitButton.disabled = true;
      submitButton.setAttribute("aria-busy", "true");
      if (label) label.textContent = messagesNow.sending;

      try {
        const body = new URLSearchParams(new FormData(form)).toString();
        const response = await fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body,
        });
        if (!response.ok) throw new Error("Form was not accepted");
        fieldsWrap.hidden = true;
        showFeedback("success");
        feedback.focus();
      } catch {
        showFeedback("failed");
        feedback.focus();
        submitButton.disabled = false;
        submitButton.removeAttribute("aria-busy");
        if (label) label.textContent = messagesNow.submit;
      }
    });
  }
</script>
