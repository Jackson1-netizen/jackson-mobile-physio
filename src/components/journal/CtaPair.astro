---
import { site } from "../../content/site";
import { messages } from "../../content/i18n";

interface Props {
  contactHref: string;
}

const { contactHref } = Astro.props;
---

<p class="jc-cta-row">
  <a href={contactHref}>
    <span data-i18n-path="home.primaryCta">{messages.en.home.primaryCta}</span>
    <span aria-hidden="true"> →</span>
  </a>
  <a href={site.phoneHref}>
    <span data-i18n-path="cta.call">{messages.en.cta.call}</span>
    <span translate="no"> {site.phone}</span>
  </a>
</p>
