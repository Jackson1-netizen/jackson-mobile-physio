---
import HomeLogo from "../home/HomeLogo.astro";
import LanguageSwitcher from "../LanguageSwitcher.astro";
import SpokenLine from "./SpokenLine.astro";
import { site } from "../../content/site";
import { messages } from "../../content/i18n";
import { journalHref } from "../../lib/journal-href";

interface Props {
  showLanguageSwitcher?: boolean;
}

const { showLanguageSwitcher = false } = Astro.props;
const t = messages.en.hm.header;
const nav = messages.en.nav;
const path = Astro.url.pathname;
const onHome = path === "/";
const href = (hash: string) => journalHref(path, hash);
const areasCurrent = path.startsWith("/areas/");

const links = [
  { href: href("#about"), label: nav.about, path: "nav.about", current: false },
  { href: href("#how"), label: nav.howItWorks, path: "nav.howItWorks", current: false },
  { href: href("#services"), label: nav.services, path: "nav.services", current: false },
  { href: href("#areas"), label: nav.areas, path: "nav.areas", current: areasCurrent },
];

const menuLinks = [
  ...links,
  { href: href("#faq"), label: nav.faq, path: "nav.faq", current: false },
  { href: href("#contact"), label: nav.contact, path: "nav.contact", current: false },
];
---

<header class="jc-header no-print">
  <div class="jc-header-row">
    <a
      class="jc-logo"
      href="/"
      aria-label={t.logoLabel}
      aria-current={onHome ? "page" : undefined}
      data-i18n-attr="aria-label:hm.header.logoLabel"
    >
      <HomeLogo alt="" sizes="180px" />
    </a>

    <nav class="jc-nav" aria-label={t.primaryNav} data-i18n-attr="aria-label:hm.header.primaryNav">
      {
        links.map((item) => (
          <a href={item.href} data-i18n-path={item.path} aria-current={item.current ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="jc-header-actions">
      <div class="jc-header-spoken">
        <SpokenLine />
      </div>
      <a class="jc-phone" href={site.phoneHref} translate="no">{site.phone}</a>
      {showLanguageSwitcher && (
        <div class="jc-header-lang">
          <LanguageSwitcher />
        </div>
      )}
      <a class="jc-pill" href={href("#contact")}>
        <span data-i18n-path="home.primaryCta">{messages.en.home.primaryCta}</span>
      </a>
      <details class="jc-menu">
        <summary data-i18n-path="hm.header.menu">{t.menu}</summary>
        <nav aria-label={t.mobileNav} data-i18n-attr="aria-label:hm.header.mobileNav">
          {
            menuLinks.map((item) => (
              <a href={item.href} data-i18n-path={item.path} aria-current={item.current ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
          <a href={site.phoneHref} translate="no">{site.phone}</a>
          <a href={href("#contact")} data-i18n-path="home.primaryCta">{messages.en.home.primaryCta}</a>
          <SpokenLine />
          {showLanguageSwitcher && <LanguageSwitcher />}
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>("details.jc-menu");
  const summary = menu?.querySelector("summary");
  if (menu && summary) {
    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        menu.open = false;
      });
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        menu.open = false;
        summary.focus();
      }
    });
    document.addEventListener("click", (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
  }
</script>
