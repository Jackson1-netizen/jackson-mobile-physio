---
import SpokenLine from "./SpokenLine.astro";
import { site } from "../../content/site";
import { messages } from "../../content/i18n";
import { journalHref } from "../../lib/journal-href";

const contactHref = journalHref(Astro.url.pathname, "#contact");
---

<div class="jc-dock no-print">
  <SpokenLine />
  <nav
    class="jc-bar"
    aria-label={messages.en.hm.mobileBar.label}
    data-i18n-attr="aria-label:hm.mobileBar.label"
  >
    <a href={site.phoneHref} data-i18n-path="cta.call">{messages.en.cta.call}</a>
    <a href={contactHref} data-i18n-path="home.primaryCta">{messages.en.home.primaryCta}</a>
  </nav>
</div>
