---
import HomeLogo from "./home/HomeLogo.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { site } from "../content/site";
import { messages } from "../content/i18n";

interface Props {
  showLanguageSwitcher?: boolean;
}

const { showLanguageSwitcher = false } = Astro.props;
const t = messages.en.hm.header;
const nav = messages.en.nav;
const primary = [
  { href: "/#services", path: "nav.services", label: nav.services },
  { href: "/#how", path: "nav.howItWorks", label: nav.howItWorks },
  { href: "/#about", path: "nav.about", label: nav.about },
  { href: "/#areas", path: "nav.areas", label: nav.areas },
] as const;
const menuLinks = [
  ...primary,
  { href: "/#ndis", path: "nav.ndis", label: nav.ndis },
  { href: "/#faq", path: "nav.faq", label: nav.faq },
  { href: "/#contact", path: "nav.contact", label: nav.contact },
] as const;
---

<header class="qb-header no-print">
  <div class="qb-wrap qb-header-inner">
    <a class="qb-logo" href="/" aria-label={t.logoLabel} data-i18n-attr="aria-label:hm.header.logoLabel">
      <HomeLogo alt="" sizes="(min-width: 1024px) 180px, 140px" />
    </a>

    <nav class="qb-nav" aria-label={t.primaryNav} data-i18n-attr="aria-label:hm.header.primaryNav">
      {
        primary.map((item) => (
          <a href={item.href} data-i18n-path={item.path}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="qb-header-tools">
      <a class="qb-header-phone" href={site.phoneHref}>{site.phone}</a>
      {showLanguageSwitcher && (
        <div class="qb-header-lang">
          <LanguageSwitcher />
        </div>
      )}
      <a class="qb-btn qb-header-cta" href="/#contact">
        <span data-i18n-path="home.primaryCta">{messages.en.home.primaryCta}</span>
      </a>
      <details class="qb-menu">
        <summary data-i18n-path="hm.header.menu">{t.menu}</summary>
        <div class="qb-menu-panel">
          <nav aria-label={t.mobileNav} data-i18n-attr="aria-label:hm.header.mobileNav">
            {
              menuLinks.map((item) => (
                <a href={item.href} data-i18n-path={item.path}>
                  {item.label}
                </a>
              ))
            }
            <a class="qb-menu-phone" href={site.phoneHref}>{site.phone}</a>
            <a class="qb-btn" href="/#contact">
              <span data-i18n-path="home.primaryCta">{messages.en.home.primaryCta}</span>
            </a>
          </nav>
          {showLanguageSwitcher && <LanguageSwitcher />}
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>("details.qb-menu");
  const header = document.querySelector<HTMLElement>(".qb-header");
  if (menu && header) {
    const summary = menu.querySelector("summary");
    const place = () => {
      document.documentElement.style.setProperty("--qb-menu-top", `${header.getBoundingClientRect().bottom}px`);
      document.documentElement.style.setProperty("--qb-header-block", `${header.offsetHeight + 12}px`);
    };
    place();
    new ResizeObserver(place).observe(header);
    menu.addEventListener("toggle", () => {
      place();
      document.body.classList.toggle("qb-menu-open", menu.open);
    });
    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        menu.open = false;
      });
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        menu.open = false;
        summary?.focus();
      }
    });
    document.addEventListener("click", (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
  }
</script>
