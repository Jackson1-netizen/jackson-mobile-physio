---
import HomeLogo from "./home/HomeLogo.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { site } from "../content/site";
import { messages } from "../content/i18n";

interface Props {
  showLanguageSwitcher?: boolean;
}

const { showLanguageSwitcher = false } = Astro.props;
const here = Astro.url.pathname;
const onAreas = here.startsWith("/areas");
const t = messages.en.hm.header;

const nav = [
  { href: "/#about", label: "About Jackson", spy: "about" },
  { href: "/#services", label: messages.en.nav.services, path: "nav.services", spy: "services" },
  { href: "/#visit", label: "Your first visit", spy: "visit" },
  { href: "/#areas", label: "Areas", spy: "areas", current: onAreas },
  { href: "/#faq", label: messages.en.nav.faq, path: "nav.faq", spy: "faq" },
];
---

<header class="a-header no-print">
  <div class="a-wrap a-header-inner">
    <a
      class="a-logo"
      href="/"
      aria-label={t.logoLabel}
      data-i18n-attr="aria-label:hm.header.logoLabel"
      aria-current={here === "/" ? "page" : undefined}
      translate="no"
    >
      <HomeLogo alt="" sizes="(min-width: 1180px) 176px, 148px" />
    </a>

    <nav class="a-nav" aria-label={t.primaryNav} data-i18n-attr="aria-label:hm.header.primaryNav">
      {
        nav.map((item) => (
          <a
            href={item.href}
            data-spy={item.spy}
            data-i18n-path={"path" in item ? item.path : undefined}
            aria-current={"current" in item && item.current ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="a-header-tools">
      <a class="a-header-phone" href={site.phoneHref} translate="no">{site.phone}</a>
      {showLanguageSwitcher && <LanguageSwitcher />}
      <a class="a-btn a-btn-primary a-header-cta" href="/#contact">
        <span data-i18n-path="home.primaryCta">{messages.en.home.primaryCta}</span>
      </a>
      <button
        type="button"
        class="a-menu-btn"
        popovertarget="a-menu"
        aria-controls="a-menu"
        aria-expanded="false"
        aria-haspopup="dialog"
      >
        <span data-i18n-path="hm.header.menu">{t.menu}</span>
      </button>
    </div>
  </div>
</header>

<div id="a-menu" class="no-print" popover="auto">
  <nav class="a-wrap a-menu-nav" aria-label={t.mobileNav} data-i18n-attr="aria-label:hm.header.mobileNav">
    {
      nav.map((item) => (
        <a
          href={item.href}
          data-spy={item.spy}
          data-i18n-path={"path" in item ? item.path : undefined}
          aria-current={"current" in item && item.current ? "page" : undefined}
        >
          {item.label}
        </a>
      ))
    }
    <a href={site.phoneHref} translate="no">{site.phone}</a>
    <a class="a-btn a-btn-primary" href="/#contact">
      <span data-i18n-path="home.primaryCta">{messages.en.home.primaryCta}</span>
    </a>
    {showLanguageSwitcher && <LanguageSwitcher />}
  </nav>
</div>

<script>
  import { initHomeMotion } from "../lib/home-motion-motion";
  initHomeMotion();
</script>
