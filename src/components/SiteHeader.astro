---
import { site, getEmailHref } from "../content/site";
import { messages } from "../content/i18n";
import LanguageSwitcher from "./LanguageSwitcher.astro";

const emailHref = getEmailHref();

const nav = [
  { href: "/#about", path: "nav.about", label: messages.en.nav.about },
  { href: "/#services", path: "nav.services", label: messages.en.nav.services },
  { href: "/#how-it-works", path: "nav.howItWorks", label: messages.en.nav.howItWorks },
  { href: "/#ndis", path: "nav.ndis", label: messages.en.nav.ndis },
  { href: "/#areas", path: "nav.areas", label: messages.en.nav.areas },
  { href: "/#faq", path: "nav.faq", label: messages.en.nav.faq },
  { href: "/#contact", path: "nav.contact", label: messages.en.nav.contact },
];
---

<header class="no-print sticky top-0 z-30 border-b border-[var(--color-border)] bg-[var(--color-surface-elevated)]/95 backdrop-blur-sm">
  <div class="border-b border-[var(--color-border)] bg-[var(--color-ink)] text-white">
    <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-2 px-4 py-2 text-sm">
      <a href={site.phoneHref} class="font-semibold text-white no-underline hover:underline">
        {site.phone}
      </a>
      <div class="flex flex-wrap items-center gap-3">
        {emailHref && (
          <a href={emailHref} class="hidden text-white/90 no-underline hover:text-white hover:underline sm:inline">
            <span data-i18n-path="cta.email">Email</span>
          </a>
        )}
        <a
          href="/referral"
          class="rounded-md bg-white/10 px-3 py-1 text-xs font-semibold text-white no-underline hover:bg-white/20"
        >
          <span data-i18n-path="nav.referralSheet">Referral sheet</span>
        </a>
        <LanguageSwitcher />
      </div>
    </div>
  </div>
  <div class="mx-auto flex max-w-5xl flex-col gap-4 px-4 py-4 lg:flex-row lg:items-center lg:justify-between">
    <a href="/" class="group text-left no-underline">
      <span class="block font-serif text-xl font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-accent)]">
        {site.businessName}
      </span>
      <span class="text-sm text-[var(--color-ink-muted)]">
        {site.tagline} · {site.locationDescriptor}
      </span>
    </a>
    <nav aria-label="Primary" class="overflow-x-auto">
      <ul class="flex min-w-max gap-x-4 gap-y-2 text-sm">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="whitespace-nowrap text-[var(--color-ink-muted)] underline-offset-4 hover:text-[var(--color-accent)] hover:underline"
              data-i18n-path={item.path}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
