---
import { site } from "../content/site";
---

{site.draft && (
  <div
    class="cf-status border-b border-amber-200 bg-[var(--color-draft-bg)] text-[var(--color-draft)]"
    role="status"
    aria-live="polite"
  >
    <div class="mx-auto max-w-5xl px-4 py-3 text-sm leading-relaxed">
      <p class="font-semibold">{site.draftNotice.title}</p>
      <p class="mt-1">{site.draftNotice.body}</p>
    </div>
  </div>
)}
