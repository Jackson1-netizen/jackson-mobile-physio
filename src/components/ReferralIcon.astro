---
interface Props { name: "plus" | "update" | "check" | "clock" | "info" | "upload" | "phone" | "mail"; }
const { name } = Astro.props;
---
<svg class="rx-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "plus" && <path d="M12 5v14M5 12h14" />}
  {name === "update" && <path d="M20 4v6h-6M20 10a8 8 0 1 0-2 8" />}
  {name === "check" && <path d="m5 12 4 4L19 6" />}
  {name === "clock" && <><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>}
  {name === "info" && <><circle cx="12" cy="12" r="9" /><path d="M12 11v6m0-10v.1" /></>}
  {name === "upload" && <path d="M12 16V3m-5 5 5-5 5 5M4 16v5h16v-5" />}
  {name === "phone" && <path d="M7 3H4a1 1 0 0 0-1 1c0 9.4 7.6 17 17 17a1 1 0 0 0 1-1v-3l-5-2-2 2a14 14 0 0 1-7-7l2-2Z" />}
  {name === "mail" && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 6 9 7 9-7" /></>}
</svg>
