---
import "../../styles/concept1.css";
import type { Concept1Theme } from "../../content/concept1-images";
import { concept1Images } from "../../content/concept1-images";
import {
  concept1Hero,
  concept1Purpose,
  concept1TrustStrip,
  concept1Services,
  concept1Steps,
  concept1MeetJackson,
  concept1Ndis,
  concept1Suburbs,
  concept1Faq,
  concept1Nav,
  concept1Phone,
  concept1PhoneHref,
} from "../../content/concept1-home";
import { site, getRegistrationDisplayLine } from "../../content/site";

interface Props {
  theme: Concept1Theme;
  mode?: "v1" | "concept";
}

const { theme, mode = "concept" } = Astro.props;
const isV1 = mode === "v1";
const homeHref = isV1 ? "/" : `/concepts/1/${theme}/`;
const headerSticky = isV1 ? "top-0" : "top-9";
const registrationLine = getRegistrationDisplayLine();
---

<div class="c1-home" data-theme={theme}>
  <header
    class={`sticky ${headerSticky} z-40 border-b border-[var(--c-border)] bg-[color-mix(in_srgb,var(--c-elevated)_94%,transparent)] backdrop-blur-md`}
  >
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-5 py-3">
      <a href={homeHref} class="flex items-center gap-3 no-underline text-[var(--c-ink)]">
        <!-- Temporary logo mark — replace with final brand asset when ready -->
        <span
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[var(--c-deep)] text-lg font-bold text-white"
          aria-hidden="true"
        >J</span>
        <span>
          <span class="font-serif text-lg font-semibold leading-tight">{site.displayBrand}</span>
          <span class="block font-sans text-xs font-normal text-[var(--c-muted)]">{site.tagline} · {site.locationDescriptor}</span>
        </span>
      </a>

      <nav class="hidden items-center gap-5 text-sm text-[var(--c-muted)] lg:flex" aria-label="Primary">
        {concept1Nav.map((item) => (
          <a href={item.href} class="no-underline hover:text-[var(--c-accent)]">{item.label}</a>
        ))}
        <a href="#referrers" class="font-semibold text-[var(--c-deep)] no-underline hover:text-[var(--c-accent)]">Refer a client</a>
      </nav>

      <div class="flex items-center gap-2">
        <details class="relative lg:hidden">
          <summary class="cursor-pointer list-none rounded-lg border border-[var(--c-border)] px-3 py-2 text-sm font-semibold marker:content-none">
            Menu
          </summary>
          <nav class="absolute right-0 z-50 mt-2 min-w-[12rem] rounded-xl border border-[var(--c-border)] bg-[var(--c-elevated)] p-3 shadow-lg">
            {concept1Nav.map((item) => (
              <a href={item.href} class="block py-2 text-sm font-medium no-underline text-[var(--c-ink)]">{item.label}</a>
            ))}
            <a href="#referrers" class="block py-2 text-sm font-semibold no-underline text-[var(--c-accent)]">Refer a client</a>
          </nav>
        </details>
        <div class="hidden gap-1 text-xs font-semibold sm:flex" aria-label="Languages">
          <span class="rounded-full bg-[var(--c-deep)] px-2 py-1 text-white">EN</span>
          <span class="rounded-full border border-[var(--c-border)] px-2 py-1">粵</span>
          <span class="rounded-full border border-[var(--c-border)] px-2 py-1">普</span>
        </div>
        <a
          href="#contact"
          class="hidden rounded-full bg-[var(--c-accent-bright)] px-4 py-2 text-sm font-bold text-white no-underline hover:bg-[var(--c-accent-hover)] sm:inline-flex"
        >{concept1Hero.primaryCta}</a>
      </div>
    </div>
  </header>

  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-[image:var(--c-hero-grad)]" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-8 px-5 py-12 lg:grid-cols-2 lg:gap-12 lg:py-16">
      <div class="border-l-[5px] border-[var(--c-accent-bright)] pl-6 lg:pl-8">
        <p class="text-xs font-bold uppercase tracking-widest text-[var(--c-accent)]">Independent mobile physiotherapy</p>
        <h1 class="mt-3 max-w-[16ch] text-[clamp(2.15rem,5vw,3.85rem)] leading-[1.06] tracking-tight">
          {concept1Hero.h1}
        </h1>
        <p class="mt-5 max-w-[44ch] text-lg text-[var(--c-muted)]">{concept1Hero.support}</p>
        <div class="mt-5 flex flex-wrap gap-2">
          {concept1Hero.chips.map((chip) => (
            <span class="rounded-full border border-[var(--c-border)] bg-[var(--c-elevated)] px-3 py-1.5 text-sm">{chip}</span>
          ))}
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="#contact"
            class="inline-flex min-h-[3.125rem] items-center justify-center rounded-full bg-[var(--c-accent-bright)] px-7 font-bold text-white no-underline hover:bg-[var(--c-accent-hover)]"
          >{concept1Hero.primaryCta}</a>
          <a
            href="#services"
            class="inline-flex min-h-[3.125rem] items-center justify-center rounded-full border-2 border-[var(--c-deep)] px-7 font-bold no-underline text-[var(--c-deep)]"
          >{concept1Hero.secondaryCta}</a>
        </div>
        <p class="mt-4 text-sm">
          <a href="#referrers" class="font-semibold text-[var(--c-accent)] no-underline hover:underline">Refer a client →</a>
        </p>
      </div>
      <div class="c1-hero-video-wrap">
        <video
          class="c1-hero-video hero-video-anim"
          autoplay
          muted
          loop
          playsinline
          poster={concept1Images.heroVideo.poster}
          aria-label={concept1Images.heroVideo.alt}
        >
          <source src={concept1Images.heroVideo.mp4} type="video/mp4" />
        </video>
        <img
          src={concept1Images.heroVideo.poster}
          alt={concept1Images.heroVideo.alt}
          class="hero-video-static absolute inset-0 h-full w-full object-cover"
          loading="eager"
          width="1200"
          height="900"
        />
        <div
          class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[color-mix(in_srgb,var(--c-deep)_35%,transparent)] via-transparent to-[color-mix(in_srgb,var(--c-surface)_20%,transparent)]"
          aria-hidden="true"
        ></div>
      </div>
    </div>
  </section>

  <!-- Post-hero trust line -->
  <section class="border-y border-[var(--c-border)] bg-[var(--c-band)] px-5 py-5 text-center">
    <p class="text-lg font-semibold text-[var(--c-ink)]">{registrationLine}</p>
    <p class="mt-1 text-base text-[var(--c-muted)]">
      Home and community visits across Melbourne — including the eastern suburbs.
    </p>
  </section>

  <!-- Purpose -->
  <section class="c1-reveal bg-[var(--c-surface)] py-16 lg:py-20">
    <div class="mx-auto max-w-3xl px-5 text-center">
      <p class="text-xs font-bold uppercase tracking-widest text-[var(--c-accent)]">What we do</p>
      <h2 class="mt-2 text-[clamp(1.75rem,4vw,2.5rem)]">{concept1Purpose.heading}</h2>
      <p class="mt-5 text-lg leading-relaxed text-[var(--c-muted)]">{concept1Purpose.body}</p>
    </div>
  </section>

  <!-- Meet Jackson — image right -->
  <section id="about" class="c1-reveal scroll-mt-24 bg-[var(--c-elevated)] py-16 lg:py-24">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 lg:grid-cols-[1.15fr_0.85fr]">
      <div class="order-2 lg:order-1">
        <p class="text-xs font-bold uppercase tracking-widest text-[var(--c-accent)]">Practitioner</p>
        <h2 class="mt-2 text-[clamp(1.85rem,4vw,2.65rem)]">{concept1MeetJackson.heading}</h2>
        {concept1MeetJackson.paragraphs.map((p) => (
          <p class="mt-4 text-[var(--c-muted)]">{p}</p>
        ))}
        <p class="mt-4 font-medium text-[var(--c-ink)]">{concept1MeetJackson.philosophy}</p>
        <p class="mt-5 text-[var(--c-muted)]">
          <strong class="text-[var(--c-ink)]">Languages:</strong> English, Cantonese, Mandarin
        </p>
        <p class="mt-4 text-sm text-[var(--c-muted)]">
          <strong class="text-[var(--c-ink)]">Qualifications:</strong> {concept1MeetJackson.qualificationsPlaceholder}
        </p>
        <p class="mt-4 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-950">{concept1MeetJackson.ahpra}</p>
      </div>
      <div class="c1-img-wrap order-1 aspect-[4/5] max-w-md justify-self-center lg:order-2 lg:justify-self-end">
        <img src={concept1Images.meetJackson.src} alt={concept1Images.meetJackson.alt} loading="lazy" width="800" height="1000" />
      </div>
    </div>
  </section>

  <!-- Trust strip -->
  <section class="c1-reveal border-y border-[var(--c-border)] bg-[var(--c-band)]" aria-label="Trust highlights">
    <div class="mx-auto grid max-w-6xl gap-3 px-5 py-6 sm:grid-cols-2 lg:grid-cols-4">
      {concept1TrustStrip.map((item) => (
        <div class="rounded-xl border border-[var(--c-border)] bg-[var(--c-elevated)] p-4 transition hover:border-[var(--c-accent)]">
          <p class="text-xs font-bold uppercase tracking-wide text-[var(--c-accent)]">{item.title}</p>
          <p class="mt-1 text-base text-[var(--c-muted)]">{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Physiotherapy at Home -->
  <section class="c1-reveal bg-[var(--c-elevated)] py-16 lg:py-24">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 lg:grid-cols-2">
      <div class="c1-img-wrap aspect-[16/10] lg:aspect-[16/11]">
        <img src={concept1Images.physioAtHome.src} alt={concept1Images.physioAtHome.alt} loading="lazy" width="1400" height="900" />
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-[var(--c-accent)]">Physiotherapy at home</p>
        <h2 class="mt-2 text-[clamp(1.85rem,4vw,2.65rem)] leading-tight">Care in the place that matters most</h2>
        <p class="mt-4 text-lg text-[var(--c-muted)]">
          Assessment and treatment where you live — mobility, strength, and everyday function. Photos are illustrative only; not
          Jackson or a specific client.
        </p>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="c1-reveal scroll-mt-24 bg-[var(--c-surface)] py-16 lg:py-24">
    <div class="mx-auto max-w-6xl px-5">
      <p class="text-xs font-bold uppercase tracking-widest text-[var(--c-accent)]">Services</p>
      <h2 class="mt-2 text-[clamp(1.85rem,4vw,2.65rem)]">How we can help</h2>
      <p class="mt-3 max-w-2xl text-[var(--c-muted)]">Discussed individually at assessment — not guaranteed outcomes.</p>
      <ul class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {concept1Services.map((name) => (
          <li>
            <a
              href="#contact"
              class="flex min-h-[4.5rem] items-center justify-between rounded-xl border border-[var(--c-border)] bg-[var(--c-elevated)] px-5 py-4 font-semibold no-underline transition hover:-translate-y-0.5 hover:border-[var(--c-accent)] hover:shadow-lg"
            >
              {name}
              <span class="text-[var(--c-accent)]" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- How it works -->
  <section id="how" class="c1-reveal scroll-mt-24 bg-[var(--c-mist)] py-16 lg:py-24">
    <div class="mx-auto max-w-6xl px-5">
      <p class="text-xs font-bold uppercase tracking-widest text-[var(--c-accent)]">How it works</p>
      <h2 class="mt-2 text-[clamp(1.85rem,4vw,2.65rem)]">A clear, personal start</h2>
      <ol class="mt-10 grid gap-4 lg:grid-cols-3">
        {concept1Steps.map((step, i) => (
          <li class="rounded-xl border border-[var(--c-border)] bg-[var(--c-elevated)] p-6 transition hover:border-[var(--c-accent)]">
            <span class="text-sm font-bold uppercase tracking-wide text-[var(--c-accent-bright)]">Step {i + 1}</span>
            <h3 class="mt-2 text-xl">{step.title}</h3>
            <p class="mt-2 text-[var(--c-muted)]">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- NDIS -->
  <section id="ndis" class="c1-reveal scroll-mt-24 bg-[var(--c-elevated)] py-16 lg:py-24">
    <div class="mx-auto max-w-3xl px-5">
      <p class="text-xs font-bold uppercase tracking-widest text-[var(--c-accent)]">Funding</p>
      <h2 class="mt-2 text-[clamp(1.85rem,4vw,2.65rem)]">{concept1Ndis.heading}</h2>
      <p class="mt-4 text-lg text-[var(--c-muted)]">{concept1Ndis.lead}</p>
      <ul class="mt-6 space-y-3 text-[var(--c-muted)]">
        {concept1Ndis.bullets.map((b) => (
          <li class="flex gap-2">
            <span class="text-[var(--c-accent)]" aria-hidden="true">•</span>
            {b}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Service areas -->
  <section id="areas" class="c1-reveal scroll-mt-24 bg-[var(--c-mist)] py-16 lg:py-24">
    <div class="mx-auto max-w-6xl px-5">
      <p class="text-xs font-bold uppercase tracking-widest text-[var(--c-accent)]">Coverage</p>
      <h2 class="mt-2 text-[clamp(1.85rem,4vw,2.65rem)]">Service areas</h2>
      <p class="mt-3 max-w-2xl text-[var(--c-muted)]">
        Mobile visits across Melbourne's eastern suburbs. No clinic address or home location pins on this map.
      </p>
      <div class="mt-8 grid gap-8 lg:grid-cols-2">
        <ul class="grid grid-cols-2 gap-2 sm:grid-cols-3">
          {concept1Suburbs.map((s) => (
            <li class="rounded-lg border border-[var(--c-border)] bg-[var(--c-elevated)] px-3 py-2 text-center text-sm font-medium">{s}</li>
          ))}
        </ul>
        <div class="c1-map flex flex-col justify-center" role="img" aria-label="Stylised service area — no address pin">
          <svg viewBox="0 0 320 200" class="mx-auto h-44 w-full max-w-sm text-[var(--c-accent)]" aria-hidden="true">
            <path
              fill="currentColor"
              fill-opacity="0.12"
              stroke="currentColor"
              stroke-width="1.5"
              d="M40 120c40-60 120-80 200-40 20 80-60 100-120 60S20 180 40 120z"></path>
          </svg>
          <p class="mt-2 text-center text-xs text-[var(--c-muted)]">Service-area illustration only — not a clinic location.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Referrers -->
  <section id="referrers" class="c1-reveal scroll-mt-24 bg-[var(--c-elevated)] py-16 lg:py-24">
    <div class="mx-auto max-w-3xl px-5 text-center">
      <h2 class="text-[clamp(1.75rem,4vw,2.35rem)]">For referrers</h2>
      <p class="mt-4 text-lg text-[var(--c-muted)]">
        GPs, support coordinators, families, and other health professionals are welcome to get in touch regarding potential referrals.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/referral" class="rounded-full bg-[var(--c-accent-bright)] px-6 py-3 font-bold text-white no-underline">Referral information</a>
        <a href={concept1PhoneHref} class="rounded-full border border-[var(--c-border)] px-6 py-3 font-bold no-underline">Call {concept1Phone}</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="c1-reveal scroll-mt-24 bg-[var(--c-surface)] py-16 lg:py-24">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="lg:sticky lg:top-24 lg:self-start">
        <p class="text-xs font-bold uppercase tracking-widest text-[var(--c-accent)]">FAQ</p>
        <h2 class="mt-2 text-[clamp(1.85rem,4vw,2.35rem)]">Useful answers before we talk</h2>
      </div>
      <div>
        {concept1Faq.map((item) => (
          <details class="group border-t border-[var(--c-border)]">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-bold marker:content-none">
              {item.q}
              <span
                class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[var(--c-border)] text-[var(--c-accent)] transition group-open:rotate-45 group-open:bg-[var(--c-accent)] group-open:text-white"
              >+</span>
            </summary>
            <p class="pb-4 pr-4 text-[var(--c-muted)]">{item.a}</p>
          </details>
        ))}
        <div class="border-t border-[var(--c-border)]"></div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="c1-reveal scroll-mt-24 bg-[var(--c-enquiry)] py-16 text-white lg:py-20">
    <div class="mx-auto max-w-3xl px-5">
      <h2 class="text-[clamp(1.75rem,4vw,2.35rem)]">Contact</h2>
      <p class="mt-3 text-[color-mix(in_srgb,white_88%,transparent)]">Make an enquiry — full form with privacy consent on production contact page.</p>
      <p class="mt-6 text-xl font-bold">
        <a href={concept1PhoneHref} class="text-white no-underline">{concept1Phone}</a>
      </p>
      <form class="mt-8 space-y-4 rounded-xl bg-white/10 p-6 backdrop-blur-sm" onsubmit="return false;">
        <label class="block text-sm">
          <span class="font-semibold">Name</span>
          <input type="text" class="mt-1 w-full rounded-lg border-0 px-3 py-2.5 text-[var(--c-ink)]" />
        </label>
        <label class="block text-sm">
          <span class="font-semibold">Suburb</span>
          <input type="text" class="mt-1 w-full rounded-lg border-0 px-3 py-2.5 text-[var(--c-ink)]" />
        </label>
        <label class="block text-sm">
          <span class="font-semibold">Message</span>
          <textarea rows="3" class="mt-1 w-full rounded-lg border-0 px-3 py-2.5 text-[var(--c-ink)]"></textarea>
        </label>
        <button type="button" class="rounded-full bg-[var(--c-accent-bright)] px-6 py-3 font-bold text-white">{concept1Hero.primaryCta}</button>
      </form>
    </div>
  </section>

  <footer class="border-t border-[var(--c-border)] bg-[var(--c-elevated)] py-10">
    <div class="mx-auto flex max-w-6xl flex-col gap-3 px-5 text-sm text-[var(--c-muted)] sm:flex-row sm:items-center sm:justify-between">
      {isV1 ? (
        <p>
          {site.displayBrand} · {site.abnDisplay} · Homepage V1 preview (draft)
        </p>
      ) : (
        <p>Concept 1 · Theme {theme.toUpperCase()} · mockup only</p>
      )}
      <p>
        {isV1 ? (
          <a href="/concepts/1/" class="text-[var(--c-accent)] no-underline hover:underline">Colour theme archive</a>
        ) : (
          <a href="/concepts/1/" class="text-[var(--c-accent)] no-underline hover:underline">Compare themes</a>
        )}
      </p>
    </div>
  </footer>

  <div class="fixed bottom-0 left-0 right-0 z-50 grid grid-cols-2 border-t border-[var(--c-border)] bg-[var(--c-elevated)] sm:hidden">
    <a href={concept1PhoneHref} class="py-3 text-center font-bold no-underline text-[var(--c-deep)]">Call</a>
    <a href="#contact" class="bg-[var(--c-deep)] py-3 text-center font-bold text-white no-underline">Enquire</a>
  </div>
  <div class="h-12 sm:hidden" aria-hidden="true"></div>
</div>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const reveals = document.querySelectorAll(".c1-reveal");
  if (reduced) {
    reveals.forEach((el) => el.classList.add("is-visible"));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
    );
    reveals.forEach((el) => observer.observe(el));
  }
</script>
