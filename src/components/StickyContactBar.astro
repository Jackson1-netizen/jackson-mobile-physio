---
import { site, getEmailHref } from "../content/site";

const emailHref = getEmailHref();
---

<nav
  class="sticky-cta no-print fixed inset-x-0 bottom-0 z-40 border-t border-[var(--color-border)] bg-[var(--color-surface-elevated)]/95 shadow-[0_-4px_24px_rgba(26,46,40,0.08)] backdrop-blur-sm sm:hidden"
  aria-label="Quick contact"
>
  <div class:list={["mx-auto grid max-w-5xl divide-x divide-[var(--color-border)]", emailHref ? "grid-cols-3" : "grid-cols-2"]}>
    <a
      href={site.phoneHref}
      class="flex flex-col items-center justify-center py-3 text-center text-xs font-semibold text-[var(--color-accent)] no-underline"
    >
      <span data-i18n-path="cta.call">Call</span>
      <span class="mt-0.5 font-normal text-[var(--color-ink-muted)]">{site.phone}</span>
    </a>
    {
      emailHref && (
        <a
          href={emailHref}
          class="flex items-center justify-center py-3 text-center text-xs font-semibold text-[var(--color-ink)] no-underline"
        >
          <span data-i18n-path="cta.email">Email</span>
        </a>
      )
    }
    <a
      href="/referral/"
      class="flex items-center justify-center py-3 text-center text-xs font-semibold text-[var(--color-ink)] no-underline"
    >
      <span data-i18n-path="nav.refer">Refer</span>
    </a>
  </div>
</nav>
