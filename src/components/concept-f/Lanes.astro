---
import { site, getReferralEmailHref } from "../../content/site";
import { messages } from "../../content/i18n";

interface Props {
  /** Homepage uses the motto as the page title. Inner pages already have an h1. */
  titleAs?: "h1" | "p";
  compact?: boolean;
}

const { titleAs = "h1", compact = false } = Astro.props;
const referralMailto = getReferralEmailHref();
---

<div class:list={["cf-lanes", compact && "cf-lanes-compact"]}>
  <section class="cf-lane cf-lane-you" id="for-you" aria-labelledby="cf-for-you-label">
    <p class="cf-kicker" id="cf-for-you-label">For you</p>
    {
      titleAs === "h1" ? (
        <h1 id="cf-motto">{site.motto}</h1>
      ) : (
        <p class="cf-lane-title" id="cf-motto">
          {site.motto}
        </p>
      )
    }
    {
      !compact && (
        <p class="cf-lane-copy" data-i18n-path="about.differentiator">
          {site.differentiator}
        </p>
      )
    }
    <div class="cf-lane-actions">
      <a class="cf-btn cf-btn-primary" href="/#contact">
        <span data-i18n-path="home.primaryCta">{messages.en.home.primaryCta}</span>
      </a>
      <a class="cf-btn cf-btn-paper" href={site.phoneHref}>
        <span data-i18n-path="cta.call">{messages.en.cta.call}</span>
        <span class="cf-btn-num">{site.phone}</span>
      </a>
    </div>
  </section>

  <section class="cf-lane cf-lane-refer" id="for-referrers" aria-labelledby="cf-for-referrers-label">
    <p class="cf-kicker" id="cf-for-referrers-label">For referrers</p>
    <p class="cf-lane-copy" data-i18n-path="referrers.lead">{site.referrersCta}</p>
    <div class="cf-lane-actions">
      <a class="cf-btn cf-btn-secondary" href="/referral/">
        <span data-i18n-path="cta.referParticipant">{messages.en.cta.referParticipant}</span>
      </a>
      <a class="cf-text-link" href={referralMailto}>{site.referralEmail}</a>
    </div>
  </section>
</div>
