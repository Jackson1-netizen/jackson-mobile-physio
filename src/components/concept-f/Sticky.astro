---
import { site } from "../../content/site";
import { messages } from "../../content/i18n";
---

<nav class="cf-sticky no-print" aria-label={messages.en.hm.mobileBar.label} data-i18n-attr="aria-label:hm.mobileBar.label">
  <a class="cf-btn cf-btn-paper" href={site.phoneHref}>
    <span data-i18n-path="cta.call">{messages.en.cta.call}</span>
  </a>
  <a class="cf-btn cf-btn-primary" href="/#contact">
    <span data-i18n-path="home.primaryCta">{messages.en.home.primaryCta}</span>
  </a>
</nav>
