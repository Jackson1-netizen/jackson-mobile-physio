---
/** Art-directed placeholders. Stock hosts blocked the preview browser, so these are not photographs. */
const shots = [
  {
    id: "chair",
    label: "Photo to be shot: empty room, one chair",
  },
  {
    id: "hall",
    label: "Photo to be shot: sunlit hallway",
  },
  {
    id: "kitchen",
    label: "Photo to be shot: kitchen, natural light",
  },
  {
    id: "table",
    label: "Photo to be shot: table by a window",
  },
] as const;
---

<section class="cf-band" id="house" aria-labelledby="cf-house-title">
  <div class="cf-wrap">
    <h2 id="cf-house-title">In the house</h2>
    <div class="cf-gallery">
      {
        shots.map((shot) => (
          <figure class="cf-tile">
            <svg viewBox="0 0 400 300" aria-hidden="true" focusable="false">
              {shot.id === "chair" && (
                <g>
                  <rect width="400" height="300" fill="#d5dfc8" />
                  <rect x="28" y="28" width="344" height="180" fill="#f7f3ec" />
                  <rect y="214" width="400" height="86" fill="#16352e" />
                  <rect x="168" y="118" width="18" height="78" fill="#16352e" />
                  <rect x="150" y="186" width="100" height="16" fill="#7f9a4e" />
                  <rect x="158" y="202" width="10" height="28" fill="#16352e" />
                  <rect x="232" y="202" width="10" height="28" fill="#16352e" />
                </g>
              )}
              {shot.id === "hall" && (
                <g>
                  <rect width="400" height="300" fill="#16352e" />
                  <rect x="48" y="24" width="304" height="252" fill="#d5dfc8" />
                  <rect x="92" y="40" width="216" height="220" fill="#d5dfc8" />
                  <rect x="140" y="58" width="120" height="184" fill="#f7f3ec" />
                  <rect x="186" y="70" width="28" height="160" fill="#7f9a4e" />
                </g>
              )}
              {shot.id === "kitchen" && (
                <g>
                  <rect width="400" height="300" fill="#d5dfc8" />
                  <rect x="36" y="28" width="150" height="110" fill="#f7f3ec" />
                  <rect x="52" y="44" width="118" height="78" fill="#7f9a4e" />
                  <rect y="168" width="400" height="22" fill="#16352e" />
                  <rect x="24" y="200" width="100" height="72" fill="#16352e" />
                  <rect x="140" y="200" width="110" height="72" fill="#16352e" />
                  <rect x="266" y="200" width="110" height="72" fill="#16352e" />
                </g>
              )}
              {shot.id === "table" && (
                <g>
                  <rect width="400" height="300" fill="#d5dfc8" />
                  <rect x="36" y="24" width="120" height="150" fill="#f7f3ec" />
                  <rect x="52" y="40" width="88" height="118" fill="#7f9a4e" />
                  <rect x="70" y="168" width="250" height="22" fill="#16352e" />
                  <rect x="96" y="190" width="16" height="70" fill="#16352e" />
                  <rect x="278" y="190" width="16" height="70" fill="#16352e" />
                  <rect x="300" y="150" width="48" height="48" fill="#d5dfc8" />
                </g>
              )}
            </svg>
            <figcaption>{shot.label}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
