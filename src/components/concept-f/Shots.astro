---
/** Flat placeholders. Stock hosts blocked the preview browser, so these are not photographs. */
const shots = [
  { tone: "sage", label: "Photo to be shot: empty room, one chair" },
  { tone: "forest", label: "Photo to be shot: sunlit hallway" },
  { tone: "sage", label: "Photo to be shot: kitchen, natural light" },
  { tone: "forest", label: "Photo to be shot: table by a window" },
] as const;
---

<section class="cf-band" id="house" aria-labelledby="cf-house-title">
  <div class="cf-wrap">
    <h2 id="cf-house-title">In the house</h2>
    <div class="cf-gallery">
      {
        shots.map((shot) => (
          <figure class:list={["cf-tile", `cf-tile-${shot.tone}`]}>
            <figcaption>{shot.label}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
