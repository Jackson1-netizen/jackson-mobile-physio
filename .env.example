# Names only. Do not commit values. Do not commit a filled-in .env.
# Public business details live in src/content/site.ts.

# Set by Netlify on each deploy. The build reads them and does not need
# them copied into the Netlify UI. See docs/DEPLOYMENT.md.
# CONTEXT
# BRANCH
# URL
# DEPLOY_PRIME_URL

# Set in netlify.toml, not a secret. package.json requires Node >= 22.12.0.
# NODE_VERSION

# Optional canonical origin for a local build that is not a Netlify preview.
# Do not set this on the Netlify preview or the cursor/design-option-2-b759
# branch deploy. Those builds use DEPLOY_PRIME_URL or URL instead.
# Setting it does not publish the site or change DNS.
# PUBLIC_SITE_URL

# Indexing is not controlled here. The launch switch is `draft` in src/content/site.ts.

# Not used by the Netlify enquiry form. Leave unset. Do not commit values.
# The form notifies hello@homemotionphysio.com.au from the Netlify dashboard.
# ENQUIRY_NOTIFICATION_EMAIL
# REFERRAL_NOTIFICATION_EMAIL
# EMAIL_DELIVERY_READY
