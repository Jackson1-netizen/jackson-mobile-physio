# Copy to `.env` locally. Do not commit `.env`.
# Public addresses are also defined in src/content/site.ts (display source of truth).

# --- Public identity (safe to display on the website) ---
# PUBLIC_BUSINESS_EMAIL=hello@homemotionphysio.com.au
# PUBLIC_REFERRAL_EMAIL=referrals@homemotionphysio.com.au

# --- Private notification destinations (server-only) ---
# Never prefix these with PUBLIC_. Never put real values in Git.
# The website must not print these addresses.
#
# ENQUIRY_NOTIFICATION_EMAIL=
# REFERRAL_NOTIFICATION_EMAIL=

# Set to true only after domain mailboxes are configured AND verified.
# EMAIL_DELIVERY_READY=false
