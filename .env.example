# Copy to `.env` locally. Do not commit `.env`.
# Public business details live in src/content/site.ts. This file has no secrets.

# Intended production origin for canonical URLs, Open Graph, JSON-LD and the sitemap.
# Setting this does not publish the site, obtain a certificate, or change DNS.
# PUBLIC_SITE_URL=https://homemotionphysio.com.au

# Indexing is NOT controlled here. The launch switch is `draft` in src/content/site.ts.

# --- Private notification destinations (server-only) ---
# Never prefix these with PUBLIC_. Never put real private addresses in Git.
# The website must not print these addresses.
#
# ENQUIRY_NOTIFICATION_EMAIL=
# REFERRAL_NOTIFICATION_EMAIL=

# Leave false. The site does not send mail. Set true only after hello@ and
# referrals@ are tested, and only in the server environment — never in Git.
# EMAIL_DELIVERY_READY=false
