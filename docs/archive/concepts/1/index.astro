---
import { concept1ThemeMeta, type Concept1Theme } from "../../../content/concept1-images";

const themes = Object.entries(concept1ThemeMeta) as [Concept1Theme, (typeof concept1ThemeMeta)[Concept1Theme]][];
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Concept 1 — compare colour themes</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&family=Source+Serif+4:wght@600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body style="font-family: 'Source Sans 3', sans-serif; background: #f4f6f4; color: #1a2e28; margin: 0; padding: 2rem 1.25rem;">
    <main style="max-width: 44rem; margin: 0 auto;">
      <p style="font-size: 0.875rem; background: #1a2e28; color: #fff; padding: 0.5rem 1rem; border-radius: 8px; text-align: center;">
        <strong>Concept 1</strong> — same homepage layout, three colour palettes. Pick <strong>A</strong>, <strong>B</strong>, or <strong>C</strong>.
      </p>
      <h1 style="font-family: 'Source Serif 4', serif; font-size: 1.85rem; margin-top: 1.5rem;">Compare colour themes</h1>
      <p style="font-size: 1.125rem; line-height: 1.6;">
        Full V2 homepage system (not production multi-page site). Hero copy and section order are locked; only palette changes.
      </p>
      <ul style="list-style: none; padding: 0; display: grid; gap: 1rem; margin-top: 2rem;">
        {themes.map(([id, meta]) => (
          <li style="border: 1px solid #c5d5cc; border-radius: 14px; background: #fff; padding: 1.25rem;">
            <h2 style="font-family: 'Source Serif 4', serif; margin: 0 0 0.35rem; font-size: 1.35rem;">
              <a href={`/concepts/1/${id}/`} style="color: #2d6a5a; text-decoration: none;">Theme {id.toUpperCase()} — {meta.label}</a>
            </h2>
            <p style="margin: 0 0 1rem; color: #3d524c; line-height: 1.55;">{meta.description}</p>
            <a
              href={`/concepts/1/${id}/`}
              style="display: inline-block; background: #2d6a5a; color: #fff; padding: 0.65rem 1.25rem; border-radius: 999px; text-decoration: none; font-weight: 600;"
            >
              Open theme {id.toUpperCase()}
            </a>
          </li>
        ))}
      </ul>
      <p style="margin-top: 2rem; font-size: 0.95rem;">
        <a href="/concepts/" style="color: #2d6a5a;">← All concepts</a>
      </p>
    </main>
    <script is:inline>
      const t = new URLSearchParams(location.search).get("theme");
      if (t === "a" || t === "b" || t === "c") location.replace("/concepts/1/" + t + "/");
    </script>
  </body>
</html>
